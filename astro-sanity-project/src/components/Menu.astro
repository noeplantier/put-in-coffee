<!-- ══ SCRIPT ════════════════════════════════════════════════ -->
<script>
  const tabs  = document.querySelectorAll<HTMLButtonElement>('.menu-tab');
  const cards = document.querySelectorAll<HTMLElement>('.menu-card');
  const empty = document.getElementById('menu-empty')!;

  // Stagger animations for visible cards
  function animateCards(visible: HTMLElement[]) {
    visible.forEach((card, i) => {
      card.style.animationDelay = `${i * 0.04}s`;
      card.style.animationName = 'none';
      // Force reflow
      void card.offsetHeight;
      card.style.animationName = '';
    });
  }

  // Filter
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.category!;

      // Update tab active state
      tabs.forEach(t => {
        t.classList.remove('menu-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('menu-tab--active');
      tab.setAttribute('aria-selected', 'true');

      // Show/hide cards
      const visible: HTMLElement[] = [];
      cards.forEach(card => {
        const show = cat === 'all' || card.dataset.category === cat;
        card.hidden = !show;
        if (show) visible.push(card);
      });

      empty.hidden = visible.length > 0;
      animateCards(visible);
    });
  });

  // Activate first tab on load
  tabs[0]?.click();

  // Add to order
  document.querySelectorAll<HTMLButtonElement>('.menu-card__add').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.item!;
      // @ts-ignore
      if (window.plausible) window.plausible('Menu Item Click', { props: { item: name } });
      window.dispatchEvent(new CustomEvent('pc:toast', {
        detail: { type: 'success', title: `☕ Added!`, message: `${name} noted for your visit.` }
      }));
    });
  });

  // Language toggle
  document.addEventListener('pc:lang', ((e: CustomEvent) => {
    const isID = e.detail.isID;
    document.querySelectorAll<HTMLElement>('[data-en][data-id]').forEach(el => {
      const val = isID ? el.dataset.id : el.dataset.en;
      if (val !== undefined) el.textContent = val;
    });
    // Re-label tabs
    tabs.forEach(tab => {
      const val = isID ? tab.dataset.id : tab.dataset.en;
      if (val) {
        const icon = tab.querySelector('.menu-tab__icon');
        const label = tab.querySelector('.menu-tab__label');
        const parts = val.split(' ');
        if (icon) icon.textContent = parts[0];
        if (label) label.textContent = parts.slice(1).join(' ');
      }
    });
  }) as EventListener);
</script>