        <div class="loc__clock-row">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="loc__clock" id="loc-clock">—</span>
          <span class="loc__tz">WITA</span>
        </div>
      </div>
      <p class="loc__next" id="loc-next"></p>
    </div>

    <!-- Contact links: Instagram · WhatsApp · TikTok -->
    <div class="loc__contacts" data-stagger>

      <!-- Instagram -->
      <a href="https://www.instagram.com/put.in.coffee/"
         target="_blank" rel="noopener noreferrer"
         class="loc__contact glass-card loc__contact--ig"
         aria-label="Instagram @put.in.coffee">
        <div class="loc__contact-icon" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="url(#ig-g)" stroke-width="1.7" fill="none"/>
            <circle cx="12" cy="12" r="4.5" stroke="url(#ig-g)" stroke-width="1.7" fill="none"/>
            <circle cx="17.5" cy="6.5" r="1.3" fill="#E07A5F"/>
            <defs>
              <linearGradient id="ig-g" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse">
                <stop offset="0%"   stop-color="#F58529"/>
                <stop offset="50%"  stop-color="#DD2A7B"/>
                <stop offset="100%" stop-color="#8134AF"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="loc__contact-body">
          <span class="loc__contact-label" data-en="instagram" data-id="instagram">instagram</span>
          <span class="loc__contact-val">@put.in.coffee</span>
        </div>
        <span class="loc__contact-arrow" aria-hidden="true">↗</span>
      </a>

      <!-- WhatsApp -->
      <a href="https://wa.me/6281916334989"
         target="_blank" rel="noopener noreferrer"
         class="loc__contact glass-card loc__contact--wa"
         aria-label="WhatsApp +62 819-1633-4989">
        <div class="loc__contact-icon" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <path d="M21 12a9 9 0 01-9 9H5l-2 2V12a9 9 0 119 0z"
                  stroke="#25D366" stroke-width="1.7" fill="none"/>
            <path d="M8.5 10.5c.2-.8 1-1.5 1.5-1.5.4 0 .7.2.9.5l.8 1.6c.1.3 0 .6-.2.8l-.5.6c.3.7.8 1.3 1.4 1.7l.7-.4c.3-.2.6-.1.8.1l1.4 1c.3.2.4.6.2.9-.4.6-1.1 1.2-1.8 1.2-2 0-4.7-3-4.7-5"
                  fill="#25D366"/>
          </svg>
        </div>
        <div class="loc__contact-body">
          <span class="loc__contact-label" data-en="whatsapp" data-id="whatsapp">whatsapp</span>
          <span class="loc__contact-val">+62 819-1633-4989</span>
        </div>
        <span class="loc__contact-arrow" aria-hidden="true">↗</span>
      </a>

      <!-- TikTok -->
      <a href="https://www.tiktok.com/@put.in_coffee"
         target="_blank" rel="noopener noreferrer"
         class="loc__contact glass-card loc__contact--tt"
         aria-label="TikTok @put.in_coffee">
        <div class="loc__contact-icon" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <path d="M9 12a4 4 0 104 4V4a5 5 0 005 5"
                  stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>
          </svg>
        </div>
        <div class="loc__contact-body">
          <span class="loc__contact-label" data-en="tiktok" data-id="tiktok">tiktok</span>
          <span class="loc__contact-val">@put.in_coffee</span>
        </div>
        <span class="loc__contact-arrow" aria-hidden="true">↗</span>
      </a>

      <!-- Address -->
      <div class="loc__contact glass-card loc__contact--addr">
        <div class="loc__contact-icon" aria-hidden="true">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"
                  stroke="currentColor" stroke-width="1.5" fill="none"/>
