<!-- ══ PAGE SCRIPTS ═══════════════════════════════════════════ -->
<script>
document.addEventListener('DOMContentLoaded', function () {

  // ── Intersection observer (reveals) ────────────────────────
  var ro = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal, .reveal-scale').forEach(function (el) { ro.observe(el); });

  // ── Experience carousel ────────────────────────────────────
  var slides = document.querySelectorAll('.xp__slide');
  var dots   = document.querySelectorAll('.xp__dot');
  var prevBtn = document.getElementById('xp-prev');
  var nextBtn = document.getElementById('xp-next');
  var current = 0;
  var total   = slides.length;
  var autoTimer = null;

  function goTo(idx) {
    if (idx === current) return;
    // Exit current
    slides[current].classList.remove('xp__slide--active');
    slides[current].classList.add('xp__slide--exit-left');
    slides[current].setAttribute('aria-hidden', 'true');
    dots[current].classList.remove('xp__dot--on');
    dots[current].setAttribute('aria-selected', 'false');

    // Tiny delay to allow exit animation to start, then reset
    var exiting = slides[current];
    setTimeout(function () {
      exiting.classList.remove('xp__slide--exit-left');
    }, 420);

    current = (idx + total) % total;

    slides[current].classList.add('xp__slide--active');
    slides[current].setAttribute('aria-hidden', 'false');
    dots[current].classList.add('xp__dot--on');
    dots[current].setAttribute('aria-selected', 'true');
  }

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      clearTimeout(autoTimer);
      goTo(parseInt(dot.getAttribute('data-goto') || '0'));
      scheduleAuto();
    });
  });

  if (prevBtn) prevBtn.addEventListener('click', function () {
    clearTimeout(autoTimer); goTo(current - 1); scheduleAuto();
  });
  if (nextBtn) nextBtn.addEventListener('click', function () {
    clearTimeout(autoTimer); goTo(current + 1); scheduleAuto();
  });

  // Touch / swipe
  var touchStartX = 0;
  var track = document.getElementById('xp-track');
  if (track) {
    track.addEventListener('touchstart', function (e) {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) {
        clearTimeout(autoTimer);
        goTo(dx < 0 ? current + 1 : current - 1);
        scheduleAuto();
      }
    }, { passive: true });
  }

  // Keyboard
  document.addEventListener('keydown', function (e) {
    var carousel = document.getElementById('xp-carousel');
    if (!carousel) return;
    var rect = carousel.getBoundingClientRect();
    var inView = rect.top < window.innerHeight && rect.bottom > 0;
    if (!inView) return;
    if (e.key === 'ArrowLeft')  { clearTimeout(autoTimer); goTo(current - 1); scheduleAuto(); }
    if (e.key === 'ArrowRight') { clearTimeout(autoTimer); goTo(current + 1); scheduleAuto(); }
  });

  function scheduleAuto() {
    autoTimer = setTimeout(function () {
      goTo(current + 1);
      scheduleAuto();
    }, 6000);
  }
  scheduleAuto();

  // ── Language switching ─────────────────────────────────────
  document.addEventListener('pc:lang', function (e) {
    var isID = e.detail && e.detail.isID;
    document.querySelectorAll('[data-en][data-id]').forEach(function (el) {
      // Skip elements with inner HTML (h2 with <br>)
      if (el.children.length > 0) return;
      var val = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (val !== null) el.textContent = val;
    });
    // Handle h2 tags with <br> (about + location headings)
    document.querySelectorAll('h2[data-en][data-id]').forEach(function (el) {
      var raw = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (raw !== null) el.innerHTML = raw;
    });
  });

  // ── Plausible tracking ─────────────────────────────────────
  var mapsBtn = document.querySelector('[data-event="Maps Click"]');
  if (mapsBtn) {
    mapsBtn.addEventListener('click', function () {
      if (window.plausible) window.plausible('Maps Click');
    });
  }

  // ── Newsletter ─────────────────────────────────────────────
  var nlForm = document.getElementById('newsletter-form');
  if (nlForm) {
    nlForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var emailInput = nlForm.querySelector('input[type="email"]');
      if (!emailInput || !emailInput.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type: 'error', title: 'Invalid email', message: 'Please enter a valid email.' } }));
        return;
      }
      try {
        await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(nlForm)).toString() });
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type: 'success', title: "You're in! ☕", message: 'Welcome to the put.in family!' } }));
        if (window.plausible) window.plausible('Newsletter Signup');
        emailInput.value = '';
      } catch {
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type: 'error', title: 'Error', message: 'Please try again later.' } }));
      }
    });
  }

});
</script>