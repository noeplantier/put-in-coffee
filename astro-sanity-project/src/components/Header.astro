---
// src/components/Header.astro
// Multi-page navigation variant (for /cafes, /about, /blog, /contact etc.)
// Bilingual EN / Bahasa Indonesia · Sunset Beach Theme

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const navLinks = [
  { label: "Home",       labelId: "Beranda",      href: "/"        },
  { label: "Our Cafés",  labelId: "Kafe Kami",    href: "/cafes"   },
  { label: "About",      labelId: "Tentang",      href: "/about"   },
  { label: "Blog",       labelId: "Blog",         href: "/blog"    },
  { label: "Contact",    labelId: "Kontak",       href: "/contact" },
];

const isActive = (href: string) => currentPath === href;
---

<!-- ══ HEADER ═════════════════════════════════════════════════ -->
<header class="pc-header" id="site-header" role="banner">
  <div class="pc-header__inner">

    <!-- ── Logo ─────────────────────────────────────────────── -->
    <a href="/" class="pc-header__logo" aria-label="put.in coffee — home">
      <div class="pc-header__logo-ring" aria-hidden="true">
        <svg width="38" height="38" viewBox="0 0 38 38" fill="none">
          <circle cx="19" cy="19" r="18" stroke="url(#hg)" stroke-width="1.5"/>
          <text x="19" y="25" text-anchor="middle" font-size="16" fill="url(#hg)">☕</text>
          <defs>
            <linearGradient id="hg" x1="0" y1="0" x2="38" y2="38">
              <stop offset="0%" stop-color="#FF9A5C"/>
              <stop offset="100%" stop-color="#FFD166"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="pc-header__steam pc-header__steam--a" aria-hidden="true"></span>
        <span class="pc-header__steam pc-header__steam--b" aria-hidden="true"></span>
      </div>
      <div>
        <span class="pc-header__brand">put.in coffee</span>
        <span class="pc-header__tagline">Pantai Biaung</span>
      </div>
    </a>

    <!-- ── Desktop nav ──────────────────────────────────────── -->
    <nav class="pc-header__desktop-nav" aria-label="Site navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`pc-header__nav-link${isActive(link.href) ? ' pc-header__nav-link--active' : ''}`}
              data-en={link.label}
              data-id={link.labelId}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              <span class="pc-header__nav-label">{link.label}</span>
              <span class="pc-header__nav-bar" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- ── Right controls ───────────────────────────────────── -->
    <div class="pc-header__controls">
      <!-- Language toggle -->
      <button id="header-lang-toggle" class="pc-header__lang-btn" aria-label="Toggle language EN/ID" aria-pressed="false">
        <span class="l-en">EN</span>
        <span class="l-sep" aria-hidden="true">|</span>
        <span class="l-id">ID</span>
      </button>

      <!-- CTA -->
      <a href="/contact" class="pc-header__cta" data-en="Order Now" data-id="Pesan Sekarang">
        <span class="pc-header__cta-text">Order Now</span>
        <span class="pc-header__cta-arrow" aria-hidden="true">→</span>
      </a>

      <!-- Hamburger -->
      <button
        id="header-hamburger"
        class="pc-header__ham"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="header-mobile-menu"
      >
        <span class="hbar hbar--1"></span>
        <span class="hbar hbar--2"></span>
        <span class="hbar hbar--3"></span>
      </button>
    </div>
  </div>

  <!-- ── Mobile menu ────────────────────────────────────────── -->
  <div
    id="header-mobile-menu"
    class="pc-header__mobile"
    role="dialog"
    aria-label="Navigation"
    aria-modal="true"
    aria-hidden="true"
  >
    <div class="pc-header__mobile-bg" aria-hidden="true"></div>

    <button id="header-mobile-close" class="pc-header__mobile-close" aria-label="Close menu">✕</button>

    <nav class="pc-header__mobile-nav" aria-label="Mobile navigation">
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class={`pc-header__mobile-link${isActive(link.href) ? ' active' : ''}`}
          style={`--i:${i}`}
          data-en={link.label}
          data-id={link.labelId}
        >
          <span class="pc-header__mobile-num">0{i+1}</span>
          <span class="pc-header__mobile-label">{link.label}</span>
          {isActive(link.href) && <span class="pc-header__mobile-dot" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>

    <a href="/contact" class="pc-header__mobile-cta" data-en="☕ Order Now" data-id="☕ Pesan Sekarang">
      ☕ Order Now
    </a>
  </div>
</header>

<!-- ══ STYLES ════════════════════════════════════════════════ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,300&family=Jost:wght@300;400;500;600&display=swap');

  :root {
    --h-height: 76px;
    --s1: #FF6B35;
    --s2: #F7931E;
    --s3: #FFD166;
    --bg: #09070F;
    --cream: #FDF6EC;
    --muted: #7A7591;
    --glass: rgba(255,255,255,0.04);
    --glass-b: rgba(255,255,255,0.08);
  }

  /* ── Header shell ───────────────────────────────────────── */
  .pc-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 200;
    height: var(--h-height);
    transition: background 0.4s, box-shadow 0.4s, backdrop-filter 0.4s;
    font-family: 'Jost', sans-serif;
  }
  .pc-header.scrolled {
    background: rgba(9,7,15,0.9);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    box-shadow: 0 1px 0 rgba(255,255,255,0.06), 0 6px 30px rgba(0,0,0,0.4);
  }

  .pc-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* ── Logo ───────────────────────────────────────────────── */
  .pc-header__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .pc-header__logo-ring {
    position: relative;
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
  }
  .pc-header__steam {
    position: absolute;
    bottom: 100%;
    width: 2px;
    border-radius: 4px;
    background: var(--s3);
    opacity: 0;
    animation: steam 2.4s ease-in-out infinite;
  }
  .pc-header__steam--a { left: 38%; height: 8px; animation-delay: 0s; }
  .pc-header__steam--b { left: 58%; height: 6px; animation-delay: 0.5s; }
  @keyframes steam {
    0%   { opacity:0; transform:translateY(0) scaleX(1); }
    30%  { opacity:0.5; }
    100% { opacity:0; transform:translateY(-14px) scaleX(0.3); }
  }
  .pc-header__brand {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 600;
    background: linear-gradient(135deg, var(--cream) 30%, var(--s3));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    line-height: 1.2;
  }
  .pc-header__tagline {
    display: block;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1;
  }

  /* ── Desktop nav ────────────────────────────────────────── */
  .pc-header__desktop-nav { display: none; }
  @media (min-width: 900px) { .pc-header__desktop-nav { display: block; } }
  .pc-header__desktop-nav ul {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    margin: 0; padding: 0;
  }
  .pc-header__nav-link {
    position: relative;
    display: block;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 3px;
    transition: color 0.3s;
  }
  .pc-header__nav-link:hover,
  .pc-header__nav-link--active { color: var(--cream); }
  .pc-header__nav-bar {
    position: absolute;
    bottom: 0; left: 0;
    height: 1px;
    width: 0;
    background: linear-gradient(90deg, var(--s1), var(--s3));
    transition: width 0.3s cubic-bezier(0.4,0,0.2,1);
    border-radius: 1px;
  }
  .pc-header__nav-link:hover .pc-header__nav-bar,
  .pc-header__nav-link--active .pc-header__nav-bar { width: 100%; }

  /* ── Controls ───────────────────────────────────────────── */
  .pc-header__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .pc-header__lang-btn {
    display: none;
    font-family: 'Jost', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    background: none;
    border: 1px solid var(--glass-b);
    border-radius: 50px;
    padding: 4px 10px;
    cursor: pointer;
    gap: 4px;
    align-items: center;
    transition: color 0.2s, border-color 0.2s;
  }
  @media (min-width: 900px) { .pc-header__lang-btn { display: flex; } }
  .pc-header__lang-btn:hover { color: var(--s3); border-color: rgba(255,209,102,0.3); }
  .pc-header__lang-btn[aria-pressed="true"] .l-en { color: var(--muted); }
  .pc-header__lang-btn[aria-pressed="true"] .l-id  { color: var(--s3); }
  .l-sep { color: var(--glass-b); }

  .pc-header__cta {
    display: none;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bg);
    text-decoration: none;
    padding: 0.55rem 1.3rem;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--s1), var(--s2), var(--s3));
    transition: transform 0.2s, box-shadow 0.3s;
    white-space: nowrap;
  }
  @media (min-width: 720px) { .pc-header__cta { display: flex; } }
  .pc-header__cta:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(247,147,30,0.45); }
  .pc-header__cta-arrow { transition: transform 0.2s; }
  .pc-header__cta:hover .pc-header__cta-arrow { transform: translateX(3px); }

  .pc-header__ham {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s;
  }
  @media (min-width: 900px) { .pc-header__ham { display: none; } }
  .pc-header__ham:hover { background: var(--glass); }
  .hbar {
    display: block;
    width: 22px; height: 1.5px;
    border-radius: 2px;
    background: var(--cream);
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.2s;
    transform-origin: center;
  }
  .pc-header__ham[aria-expanded="true"] .hbar--1 { transform: translateY(6.5px) rotate(45deg); }
  .pc-header__ham[aria-expanded="true"] .hbar--2 { opacity: 0; transform: scaleX(0); }
  .pc-header__ham[aria-expanded="true"] .hbar--3 { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Mobile overlay ─────────────────────────────────────── */
  .pc-header__mobile {
    position: fixed;
    inset: 0;
    z-index: 190;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    overflow: hidden;
  }
  .pc-header__mobile[aria-hidden="false"] { opacity: 1; pointer-events: all; }
  .pc-header__mobile-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, #09070F, #180d08, #0f0c18);
  }
  .pc-header__mobile-close {
    position: absolute;
    top: 1.5rem; right: 1.5rem;
    font-size: 1.4rem;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.2s, transform 0.2s;
    z-index: 1;
    padding: 0.5rem;
  }
  .pc-header__mobile-close:hover { color: var(--cream); transform: rotate(90deg); }

  .pc-header__mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    z-index: 1;
    width: 100%;
  }
  .pc-header__mobile-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    padding: 0.7rem 1.5rem;
    border-radius: 12px;
    width: 100%;
    max-width: 320px;
    opacity: 0;
    transform: translateX(-20px);
    transition: background 0.2s;
  }
  .pc-header__mobile[aria-hidden="false"] .pc-header__mobile-link {
    animation: slide-in-h 0.4s ease forwards;
    animation-delay: calc(var(--i) * 0.07s + 0.05s);
  }
  @keyframes slide-in-h {
    to { opacity: 1; transform: translateX(0); }
  }
  .pc-header__mobile-link:hover { background: rgba(255,255,255,0.04); }
  .pc-header__mobile-link.active { background: rgba(247,147,30,0.08); }
  .pc-header__mobile-num {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--s2);
    font-family: 'Jost', sans-serif;
  }
  .pc-header__mobile-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 500;
    color: var(--cream);
    transition: color 0.2s;
  }
  .pc-header__mobile-link:hover .pc-header__mobile-label,
  .pc-header__mobile-link.active .pc-header__mobile-label {
    background: linear-gradient(135deg, var(--s1), var(--s3));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .pc-header__mobile-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--s2);
    box-shadow: 0 0 8px var(--s2);
    margin-left: auto;
    flex-shrink: 0;
  }

  .pc-header__mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bg);
    text-decoration: none;
    padding: 0.9rem 2.5rem;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--s1), var(--s3));
    box-shadow: 0 6px 28px rgba(255,107,53,0.35);
    z-index: 1;
    transition: transform 0.2s, box-shadow 0.3s;
    opacity: 0;
  }
  .pc-header__mobile[aria-hidden="false"] .pc-header__mobile-cta {
    animation: slide-in-h 0.4s ease 0.42s forwards;
  }
  .pc-header__mobile-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(255,107,53,0.5); }

  .pc-header__mobile-footer {
    position: absolute;
    bottom: 2rem;
    display: flex;
    gap: 2rem;
    font-family: 'Jost', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    z-index: 1;
  }

  @media (min-width: 900px) {
    .pc-header__mobile { display: none !important; }
  }
</style>

<!-- ══ SCRIPT ════════════════════════════════════════════════ -->
<script>
  const header = document.getElementById('site-header')!;
  const ham    = document.getElementById('header-hamburger')!;
  const menu   = document.getElementById('header-mobile-menu')!;
  const close  = document.getElementById('header-mobile-close')!;
  const langBtn= document.getElementById('header-lang-toggle')!;

  // Scroll effect
  const tick = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', tick, { passive: true });
  tick();

  // Mobile open/close
  function openMenu() {
    menu.setAttribute('aria-hidden', 'false');
    ham.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu.setAttribute('aria-hidden', 'true');
    ham.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  ham.addEventListener('click', openMenu);
  close.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

  // Language
  let isID = false;
  langBtn.addEventListener('click', () => {
    isID = !isID;
    langBtn.setAttribute('aria-pressed', String(isID));
    // Dispatch global lang change event for other components to react
    document.dispatchEvent(new CustomEvent('pc:lang', { detail: { isID } }));
    // Update nav labels
    document.querySelectorAll<HTMLElement>('.pc-header__nav-label, .pc-header__mobile-label, .pc-header__cta-text, .pc-header__mobile-cta').forEach(el => {
      const parent = el.closest('[data-en]') as HTMLElement | null;
      if (parent) {
        const val = isID ? parent.dataset.id : parent.dataset.en;
        if (val) el.textContent = val;
      }
    });
  });
</script>