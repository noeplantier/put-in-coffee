---
// src/components/ReservationForm.astro
// put.in coffee · reservation & contact · v2 · EN / ID
// No backend — DM pré-rempli Instagram + Netlify Forms fallback
---

<section class="res" id="contact" aria-label="reserve a table">
  <div class="res__container">
    <div class="res__inner">

      <!-- ══ LEFT: info ═════════════════════════════════════ -->
      <div class="res__info">

        <p class="eyebrow res__reveal"
           data-en="get in touch" data-id="hubungi kami">get in touch</p>

            <h2 class="res__title res__reveal">
              <span data-en="reserve your" data-id="pesan meja anda">reserve your</span><br>
              <span data-en="slice of paradise" data-id="surga tepi pantai">slice of paradise</span>
            </h2>


        <p class="res__sub res__reveal"
           data-en="sunrise coffee, romantic sunset dinners, or a private beach event — we'll make every moment count at pantai biaung."
           data-id="kopi pagi hari, makan malam romantis, atau acara privat di tepi pantai — kami akan membuat setiap momen berharga di pantai biaung.">
          sunrise coffee, romantic sunset dinners, or a private beach event — we'll make every moment count at pantai biaung.
        </p>

        <!-- ── Real-time status pill ──────────────────────── -->
        <div class="res__status res__reveal" id="res-status-bar">
          <span class="res__status-dot" id="res-dot"></span>
          <span class="res__status-label" id="res-status-text"
                data-open-en="open now" data-open-id="buka sekarang"
                data-closed-en="closed" data-closed-id="tutup">—</span>
          <span class="res__status-sep" aria-hidden="true">·</span>
          <span class="res__status-time" id="res-time">—</span>
          <span class="res__status-tz">WITA</span>
        </div>

        <!-- ── Info cards ─────────────────────────────────── -->
        <div class="res__cards res__reveal">

          <!-- Hours -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                <path d="M12 7v5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="hours" data-id="jam buka">hours</strong>
              <span id="res-hours-dynamic" data-en="7am – 11pm · daily" data-id="07.00 – 23.00 · setiap hari">7am – 11pm · daily</span>
            </div>
          </div>

          <!-- Location -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="location" data-id="lokasi">location</strong>
              <span data-en="Pantai Biaung, Denpasar, Bali" data-id="Pantai Biaung, Denpasar, Bali">Pantai Biaung, Denpasar, Bali</span>
            </div>
          </div>

          <!-- Response -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="response" data-id="respons">response</strong>
              <span data-en="within 2 hours · no card needed" data-id="dalam 2 jam · tanpa kartu kredit">within 2 hours · no card needed</span>
            </div>
          </div>

          <!-- Vibe -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M3 17c2-4 5-7 9-7s7 3 9 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                <path d="M1 20h22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 10V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="12" cy="4" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="vibe" data-id="suasana">vibe</strong>
              <span data-en="beachfront · free wifi · dogs welcome" data-id="tepi pantai · wifi gratis · boleh bawa anjing">beachfront · free wifi · dogs welcome</span>
            </div>
          </div>

          <!-- Parking -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M9 17V7h4a3 3 0 010 6H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="parking" data-id="parkir">parking</strong>
              <span data-en="free on-site · motorbike & car" data-id="parkir gratis · motor & mobil">free on-site · motorbike & car</span>
            </div>
          </div>

          <!-- Live music — updated: Karaoke + live music SUN -->
          <div class="res__card">
            <div class="res__card-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="res__card-text">
              <strong data-en="live music" data-id="musik live">live music</strong>
              <span data-en="karaoke & live music · sundays 7–9pm" data-id="karaoke & musik live · minggu 19.00–21.00">karaoke & live music · sundays 7–9pm</span>
            </div>
          </div>

        </div><!-- /.res__cards -->

        <!-- ── Social links ───────────────────────────────── -->
        <div class="res__socials res__reveal">

          <!-- Instagram -->
          <a href="https://www.instagram.com/put.in.coffee/"
             class="res__social-btn res__social-ig"
             target="_blank" rel="noopener" aria-label="Instagram @put.in.coffee">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="url(#ig-grad)" stroke-width="1.7" fill="none"/>
              <circle cx="12" cy="12" r="4.5" stroke="url(#ig-grad)" stroke-width="1.7" fill="none"/>
              <circle cx="17.5" cy="6.5" r="1.2" fill="#E07A5F"/>
              <defs>
                <linearGradient id="ig-grad" x1="2" y1="22" x2="22" y2="2" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#F58529"/>
                  <stop offset="40%" stop-color="#DD2A7B"/>
                  <stop offset="100%" stop-color="#8134AF"/>
                </linearGradient>
              </defs>
            </svg>
            <span>@put.in.coffee</span>
          </a>

          <!-- TikTok -->
          <a href="https://www.tiktok.com/@put.in_coffee"
             class="res__social-btn res__social-tt"
             target="_blank" rel="noopener" aria-label="TikTok @put.in_coffee">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9a8.18 8.18 0 004.78 1.52V7.08a4.85 4.85 0 01-1.01-.39z" fill="currentColor"/>
            </svg>
            <span>@put.in_coffee</span>
          </a>

          <!-- WhatsApp -->
          <a href="https://wa.me/6281916334989"
             id="whatsapp-link"
             class="res__social-btn res__social-wa"
             target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" fill="#25D366"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.975-1.306A9.96 9.96 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.96 7.96 0 01-4.073-1.115l-.292-.173-3.032.796.809-2.965-.19-.305A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z" fill="#25D366"/>
            </svg>
            <span data-en="WhatsApp" data-id="chat WhatsApp">WhatsApp</span>
          </a>

          <!-- Share -->
          <button id="share-btn" class="res__social-btn res__social-share" aria-label="Share this page" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span data-en="share" data-id="bagikan">share</span>
          </button>

        </div><!-- /.res__socials -->
      </div><!-- /.res__info -->

      <!-- ══ RIGHT: form ════════════════════════════════════ -->
      <div class="res__form-wrap res__reveal-scale" id="res-form-container">

        <form
          id="res-form"
          class="res__form"
          name="reservation"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="reservation"/>
          <p aria-hidden="true" style="display:none">
            <label>skip: <input name="bot-field" tabindex="-1" autocomplete="off"/></label>
          </p>

          <h3 class="res__form-title" data-en="make a reservation" data-id="buat reservasi">make a reservation</h3>

          <!-- Row 1: name + email -->
          <div class="res__row">
            <div class="res__field">
              <label for="r-name" class="res__label">
                <span data-en="full name" data-id="nama lengkap">full name</span>
                <span class="res__req" aria-label="required">*</span>
              </label>
              <input type="text" id="r-name" name="name" class="res__input" placeholder="your name" required autocomplete="name"/>
            </div>
            <div class="res__field">
              <label for="r-email" class="res__label">
                <span data-en="email" data-id="email">email</span>
                <span class="res__req">*</span>
              </label>
              <input type="email" id="r-email" name="email" class="res__input" placeholder="you@email.com" required autocomplete="email"/>
            </div>
          </div>

          <!-- Row 2: phone + guests -->
          <div class="res__row">
            <div class="res__field">
              <label for="r-phone" class="res__label">
                <span data-en="whatsapp / phone" data-id="whatsapp / telepon">whatsapp / phone</span>
              </label>
              <input type="tel" id="r-phone" name="phone" class="res__input" placeholder="+62 …" autocomplete="tel"/>
            </div>
            <div class="res__field">
              <label for="r-guests" class="res__label">
                <span data-en="guests" data-id="jumlah tamu">guests</span>
              </label>
              <select id="r-guests" name="guests" class="res__input">
                <option value="" data-en="select…" data-id="pilih…">select…</option>
                <option value="1"    data-en="1 guest"             data-id="1 tamu">1 guest</option>
                <option value="2"    data-en="2 guests"            data-id="2 tamu">2 guests</option>
                <option value="3-5"  data-en="3–5 guests"          data-id="3–5 tamu">3–5 guests</option>
                <option value="6-10" data-en="6–10 guests"         data-id="6–10 tamu">6–10 guests</option>
                <option value="10+"  data-en="10+ (private event)" data-id="10+ (acara privat)">10+ (private event)</option>
              </select>
            </div>
          </div>

          <!-- Row 3: date + time -->
          <div class="res__row">
            <div class="res__field">
              <label for="r-date" class="res__label">
                <span data-en="preferred date" data-id="tanggal pilihan">preferred date</span>
              </label>
              <input type="date" id="r-date" name="date" class="res__input"/>
            </div>
            <div class="res__field">
              <label for="r-time" class="res__label">
                <span data-en="preferred time" data-id="waktu pilihan">preferred time</span>
              </label>
              <select id="r-time" name="time" class="res__input">
                <option value="">select time…</option>
                <option value="07:00" data-en="7:00 am — sunrise"   data-id="07.00 — matahari terbit">7:00 am — sunrise</option>
                <option value="09:00" data-en="9:00 am — morning"   data-id="09.00 — pagi">9:00 am — morning</option>
                <option value="12:00" data-en="12:00 pm — lunch"    data-id="12.00 — makan siang">12:00 pm — lunch</option>
                <option value="15:00" data-en="3:00 pm — afternoon" data-id="15.00 — sore">3:00 pm — afternoon</option>
                <option value="17:30" data-en="5:30 pm — sunset"    data-id="17.30 — senja">5:30 pm — sunset</option>
                <option value="19:00" data-en="7:00 pm — dinner"    data-id="19.00 — makan malam">7:00 pm — dinner</option>
              </select>
            </div>
          </div>

          <!-- Special requests -->
          <div class="res__field">
            <label for="r-msg" class="res__label">
              <span data-en="special requests" data-id="permintaan khusus">special requests</span>
            </label>
            <textarea id="r-msg" name="message" class="res__input" rows="3"
              placeholder="allergies, special occasions, seating preferences…"></textarea>
          </div>

          <!-- Action buttons -->
          <div class="res__actions">
            <!-- Primary: send DM to Instagram -->
            <button type="button" id="res-ig-btn" class="res__btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.6" fill="none"/>
                <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6" fill="none"/>
                <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
              </svg>
              <span class="res__btn-text" data-en="send DM" data-id="kirim via instagram DM">send via instagram DM</span>
            </button>

          <p class="res__note"
             data-en="we reply within 2 hours · free · no credit card needed"
             data-id="kami membalas dalam 2 jam · gratis · tanpa kartu kredit">
            we reply within 2 hours · free · no credit card needed
          </p>
        </form>

        <!-- Success state -->
        <div id="res-success" class="res__success" hidden>
          <div class="res__success-anim" aria-hidden="true">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
              <circle cx="28" cy="28" r="26" stroke="#C9924A" stroke-width="1.5" fill="rgba(201,146,74,0.08)"/>
              <path d="M17 28l8 8 14-16" stroke="#5bdb83" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 data-en="reservation received!" data-id="reservasi diterima!">reservation received!</h3>
          <p data-en="we'll confirm your table within 2 hours. see you at pantai biaung"
             data-id="kami akan mengkonfirmasi meja anda dalam 2 jam. sampai jumpa di pantai biaung">
            we'll confirm your table within 2 hours. see you at pantai biaung
          </p>
          <a href="#menu" class="res__btn-outline" data-en="explore the menu" data-id="lihat menu">explore the menu</a>
        </div>

      </div><!-- /.res__form-wrap -->
    </div><!-- /.res__inner -->
  </div><!-- /.res__container -->
</section>

<style>
/* ── Container ──────────────────────────────────────────────── */
.res {
  padding: var(--section-py, 5rem) 0;
}
.res__container {
  max-width: var(--content-width, 1100px);
  margin: 0 auto;
  padding: 0 var(--container-px, 1.5rem);
}
.res__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: start;
}
@media (max-width: 860px) {
  .res__inner { grid-template-columns: 1fr; gap: 3rem; }
}

/* ── Reveals ────────────────────────────────────────────────── */
.res__reveal {
  opacity: 0; transform: translateY(18px);
  transition: opacity .55s ease, transform .55s ease;
}
.res__reveal.in { opacity: 1; transform: none; }
.res__reveal-scale {
  opacity: 0; transform: scale(0.97);
  transition: opacity .6s ease, transform .6s ease;
}
.res__reveal-scale.in { opacity: 1; transform: none; }

/* ── Eyebrow ────────────────────────────────────────────────── */
.eyebrow {
  font-size: .7rem; font-weight: 600; letter-spacing: .14em;
  text-transform: uppercase; color: var(--gold, #C9924A);
  display: block; margin-bottom: .5rem;
}

/* ── Title ──────────────────────────────────────────────────── */
.res__title {
  font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  font-weight: 400; 
  color: var(--cream, #F0E8DC);
  margin: 0 0 1rem; line-height: 1.2;
}
.res__title em {
   font-weight: 400;
  background: linear-gradient(135deg, var(--gold-lt, #E8C97A), var(--gold, #C9924A));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.res__sub {
  font-size: .875rem; font-weight: 300; color: var(--muted, rgba(240,232,220,0.45));
  line-height: 1.7; margin: 0 0 1.5rem; text-transform: lowercase;
}

/* ── Status pill ────────────────────────────────────────────── */
.res__status {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .38rem .9rem; border-radius: 50px;
  border: 1px solid rgba(255,255,255,0.1);
  background: rgba(255,255,255,0.03);
  margin-bottom: 1.5rem;
  font-size: .72rem; font-weight: 400; text-transform: lowercase;
}
.res__status-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  background: #888; transition: background .4s;
}
.res__status-dot.open  { background: #5bdb83; box-shadow: 0 0 7px rgba(91,219,131,.55); animation: res-pulse 2.5s ease-in-out infinite; }
.res__status-dot.closed{ background: #666; }
@keyframes res-pulse { 0%,100%{box-shadow:0 0 5px rgba(91,219,131,.4);} 50%{box-shadow:0 0 12px rgba(91,219,131,.7);} }
.res__status-label { font-weight: 600; color: var(--muted, rgba(240,232,220,.45)); transition: color .4s; }
.res__status-label.open   { color: #5bdb83; }
.res__status-label.closed { color: var(--muted); }
.res__status-sep { color: rgba(255,255,255,.15); }
.res__status-time { font-family: var(--font-display, serif); font-style: italic; color: var(--gold-lt, #E8C97A); }
.res__status-tz { font-size: .6rem; letter-spacing: .08em; color: var(--muted); }

/* ── Info cards ─────────────────────────────────────────────── */
.res__cards {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: .6rem; margin-bottom: 2rem;
}
.res__card {
  display: flex; align-items: flex-start; gap: .7rem;
  padding: .85rem 1rem;
  background: var(--glass, rgba(240,232,220,.03));
  border: 1px solid var(--border, rgba(240,232,220,.08));
  border-radius: 12px;
  transition: border-color .2s, background .2s;
}
.res__card:hover {
  border-color: rgba(201,146,74,.2);
  background: rgba(201,146,74,.04);
}
.res__card-icon {
  width: 34px; height: 34px; flex-shrink: 0;
  border-radius: 9px;
  background: rgba(201,146,74,.07);
  border: 1px solid rgba(201,146,74,.12);
  display: flex; align-items: center; justify-content: center;
  color: var(--gold, #C9924A);
}
.res__card-text {
  display: flex; flex-direction: column; gap: 2px; min-width: 0;
}
.res__card-text strong {
  font-size: .68rem; font-weight: 600;
  color: var(--cream, #F0E8DC); letter-spacing: .05em; text-transform: lowercase;
}
.res__card-text span {
  font-size: .68rem; font-weight: 300;
  color: var(--muted, rgba(240,232,220,.45)); text-transform: lowercase; line-height: 1.45;
}

/* ── Social buttons ─────────────────────────────────────────── */
.res__socials {
  display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
}
.res__social-btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: .4rem; height: 38px;
  border-radius: 50px; padding: 0 .95rem;
  background: var(--glass, rgba(240,232,220,.03));
  border: 1px solid var(--border, rgba(240,232,220,.08));
  font-size: .72rem; font-weight: 400; color: var(--muted);
  cursor: pointer; text-decoration: none;
  transition: border-color .2s, background .2s, color .2s, transform .15s;
  white-space: nowrap;
}
