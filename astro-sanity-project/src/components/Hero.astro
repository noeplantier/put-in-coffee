---
// src/components/Hero.astro
// Refined hero · lowercase · minimal · EN/ID

import type { SiteSettings } from '../types/index.ts';
export interface Props { settings?: Partial<SiteSettings>; }
const { settings = {} } = Astro.props;

const headline    = settings?.heroHeadline       ?? 'PUT.IN COFFEE';
const headlineEm  = settings?.heroHeadlineItalic ?? 'meet coffee';
const subtitle    = settings?.heroSubtitle       ?? "specialty coffee on the shoreline. sip slowly, breathe deeply — you're at pantai biaung now.";
const subtitleId  = "kopi spesialti di tepi pantai. minum pelan, nikmati angin — anda sudah di pantai biaung.";
const reviews     = settings?.totalReviews       ?? 49;
---

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="hero" id="hero" aria-label="welcome to put.in coffee">


  <!-- warm image overlay -->
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- content -->
  <div class="hero__body">

    <!-- location pill -->
    <div class="hero__pill">
      <span class="hero__pill-dot" aria-hidden="true"></span>
      <span data-en="pantai biaung · sanur, bali" data-id="pantai biaung · sanur, bali">
        pantai biaung · sanur, bali
      </span>
    </div>

    <!-- headline -->
    <h1 class="hero__title">
      <span class="hero__title-plain" data-en={headline} data-id="ombak bertemu">{headline}</span><br>
      <em class="hero__title-em" data-en={headlineEm} data-id="cita kopi">{headlineEm}</em>
    </h1>

    <!-- subtitle -->
    <p class="hero__sub" data-en={subtitle} data-id={subtitleId}>
      {subtitle}
    </p>

    <!-- ctas -->
    <div class="hero__ctas">
      <a href="#menu" class="btn btn-primary" data-en="explore menu" data-id="lihat menu">
        <span>☕</span>
        <span class="hero__cta-text">explore menu</span>
      </a>
      <a href="#contact" class="btn btn-outline" data-en="reserve a table" data-id="reservasi meja">
        <span>🌊</span>
        <span class="hero__cta-text">reserve a table</span>
      </a>
    </div>

    <!-- social proof -->
    <div class="hero__proof">
      <div class="hero__stars" aria-label="5 stars">
        {[1,2,3,4,5].map(i => (
          <span class="hero__star" style={`animation-delay:${(i-1)*0.08+0.9}s`} aria-hidden="true">★</span>
        ))}
      </div>
      <span class="hero__proof-copy">
        <strong>{reviews}+</strong>
      </span>
    </div>

  </div>



  <!-- scroll cue -->
  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>

</section>

<style>
  /* ── Shell ───────────────────────────────────────────────── */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* ── Background image ────────────────────────────────────── */
  .hero__img-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 35%;
    transform: scale(1.05);
    transition: transform 16s ease-out, opacity 1s ease;
    opacity: 0;
    will-change: transform;
  }
  .hero__img.loaded { opacity: 1; transform: scale(1); }

  /* ── Overlay ─────────────────────────────────────────────── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom,
        rgba(11,9,8,0.5)  0%,
        rgba(11,9,8,0.25) 35%,
        rgba(11,9,8,0.3)  60%,
        rgba(11,9,8,0.88) 100%
      ),
      linear-gradient(to right, rgba(11,9,8,0.45) 0%, transparent 55%);
  }

  /* ── Content ─────────────────────────────────────────────── */
  .hero__body {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 820px;
    padding: 0 1.5rem;
    margin-top: calc(var(--nav-h) * 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* pill */
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    border: 1px solid rgba(201,146,74,0.25);
    background: rgba(201,146,74,0.07);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--gold-lt);
    text-transform: lowercase;
    animation: fade-down 0.8s ease 0.1s both;
  }
  .hero__pill-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #5bdb83;
    box-shadow: 0 0 5px #5bdb83;
    animation: dot-pulse 2.5s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes dot-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.45; }
  }

  /* headline */
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 1.02;
    color: var(--cream);
    margin: 0;
    text-shadow: 0 2px 30px rgba(0,0,0,0.6);
    animation: fade-up 0.9s ease 0.25s both;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }
  .hero__title-em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(135deg, var(--gold-lt) 0%, #f0cf90 60%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* subtitle */
  .hero__sub {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 2.2vw, 1.05rem);
    font-weight: 300;
    line-height: 1.7;
    color: rgba(240,232,220,0.65);
    max-width: 480px;
    margin: 0;
    text-transform: lowercase;
    animation: fade-up 0.9s ease 0.4s both;
  }

  /* ctas */
  .hero__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    animation: fade-up 0.9s ease 0.55s both;
  }
  .hero__cta-text { font-size: 0.8rem; }

  /* social proof */
  .hero__proof {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    animation: fade-up 0.9s ease 0.7s both;
  }
  .hero__stars { display: flex; gap: 1px; }
  .hero__star {
    font-size: 0.78rem;
    color: var(--gold);
    animation: star-pop 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
    display: inline-block;
  }
  @keyframes star-pop {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }
  .hero__proof-copy {
    font-size: 0.75rem;
    font-weight: 300;
    color: rgba(240,232,220,0.45);
    text-transform: lowercase;
  }
  .hero__proof-copy strong { color: var(--gold-lt); font-weight: 500; margin-right: 2px; }

  /* open badge */
  .hero__open {
    position: absolute;
    bottom: 22%;
    right: 1.5rem;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.4rem 0.85rem;
    border-radius: 50px;
    background: rgba(11,9,8,0.55);
    border: 1px solid rgba(240,232,220,0.08);
    backdrop-filter: blur(8px);
    font-size: 0.65rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: rgba(240,232,220,0.5);
    z-index: 2;
    text-transform: lowercase;
    animation: fade-in 1s ease 1s both;
  }
  .hero__open-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: #5bdb83;
    box-shadow: 0 0 5px #5bdb83;
    animation: dot-pulse 2.5s infinite;
    flex-shrink: 0;
  }
  @media (max-width: 540px) { .hero__open { display: none; } }

  /* scroll cue */
  .hero__scroll {
    position: absolute;
    bottom: 22%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    animation: fade-in 1s ease 1.2s both;
  }
  .hero__scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(201,146,74,0.5), transparent);
    animation: scroll-drip 2.2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes scroll-drip {
    0%        { transform: scaleY(0); opacity: 0; transform-origin: top; }
    40%       { transform: scaleY(1); opacity: 0.8; }
    100%      { transform: scaleY(1); opacity: 0; transform-origin: bottom; }
  }

  /* animations */
  @keyframes fade-down {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>

<script>
  // image parallax + fade-in
  const img = document.getElementById('hero-img') as HTMLImageElement;
  if (img) {
    const show = () => img.classList.add('loaded');
    img.complete ? show() : img.addEventListener('load', show);
  }

  // language listener
  document.addEventListener('pc:lang', ((e: CustomEvent) => {
    const isID = e.detail.isID as boolean;
    document.querySelectorAll<HTMLElement>('[data-en][data-id]').forEach(el => {
      const val = isID ? el.dataset.id : el.dataset.en;
      // skip if has child spans (cta buttons)
      if (val && !el.querySelector('span')) el.textContent = val;
      // for cta buttons, update the text span
      const textEl = el.querySelector<HTMLElement>('.hero__cta-text');
      if (val && textEl) textEl.textContent = val;
    });
  }) as EventListener);

  // plausible events
  document.querySelectorAll<HTMLElement>('[data-event]').forEach(el => {
    el.addEventListener('click', () => {
      // @ts-ignore
      if (el.dataset.event && window.plausible) window.plausible(el.dataset.event);
    });
  });
</script>