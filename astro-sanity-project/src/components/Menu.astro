---

<section class="menu" id="menu" aria-label="our menu">
  <div class="menu__wrap">

    <header class="menu__head reveal">
      <p class="eyebrow" data-en="what we brew" data-id="apa yang kami sajikan">what we brew</p>
      <h2 data-en="the put.in menu" data-id="menu put.in">the put.in menu</h2>
      <p class="menu__sub"
        data-en="bali highland beans, honest food, ocean breeze — served daily from 7am."
        data-id="biji kopi pegunungan bali, makanan jujur, angin laut — disajikan setiap hari mulai jam 7.">
        bali highland beans, honest food, ocean breeze — served daily from 7am.
      </p>
    </header>

    <nav class="menu__nav" role="tablist" aria-label="menu categories">
      {tabs.map((t, i) => (
        <button
          class="menu__navbtn"
          data-cat={t.id}
          data-color={t.color}
          data-en={t.en}
          data-id={t.id_}
          role="tab"
          aria-selected="false"
        >
          <span class="menu__navbtn-label">{t.en}</span>
          <span class="menu__navbtn-count"></span>
        </button>
      ))}
    </nav>

    {tabs.map((t, ti) => (
      <div class={`menu__lane${ti === 0 ? '' : ' menu__lane--hidden'}`} data-lane={t.id} role="tabpanel">
        <div class="menu__track" data-track={t.id}>
          {items.filter(item => item.category === t.id).map((item) => (
            <button
              class="menu__card"
              data-id={item.id}
              data-cat={item.category}
              aria-label={`view ${item.name}`}
              type="button"
            >
              {item.tag && (
                <span class={`menu__tag menu__tag--${item.tag}`}>
                  {item.tag === 'bestseller' ? 'best seller' : item.tag === 'new' ? 'new' : 'signature'}
                </span>
              )}
              <div class="menu__icon-wrap" aria-hidden="true">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" class="menu__icon" set:html={icons[item.icon] ?? icons['espresso']}/>
              </div>
              <div class="menu__card-body">
                <h3 class="menu__card-name" data-en={item.name} data-id={item.nameId}>{item.name}</h3>
                {item.size && <span class="menu__card-size">{item.size}</span>}
                <p class="menu__card-price">{item.price}</p>
              </div>
              <div class="menu__card-shine" aria-hidden="true"></div>
            </button>
          ))}
        </div>
        <button class="menu__arrow menu__arrow--prev" data-track={t.id} aria-label="scroll left" type="button">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="menu__arrow menu__arrow--next" data-track={t.id} aria-label="scroll right" type="button">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    ))}

  </div>
</section>

<!-- DRAWER -->
<div class="mdrawer" id="menu-drawer" aria-modal="true" role="dialog" aria-label="item detail" style="display:none">
  <div class="mdrawer__backdrop"></div>
  <div class="mdrawer__sheet">
    <button class="mdrawer__close" type="button" aria-label="close">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <div class="mdrawer__icon-stage">
      <svg width="72" height="72" viewBox="0 0 24 24" fill="none" id="drawer-icon" class="mdrawer__bigicon"></svg>
      <div class="mdrawer__glow-ring" aria-hidden="true"></div>
    </div>
    <div class="mdrawer__body">
      <div class="mdrawer__meta">
        <span class="mdrawer__tag" id="drawer-tag" style="display:none"></span>
        <span class="mdrawer__size" id="drawer-size" style="display:none"></span>
      </div>
      <h2 class="mdrawer__name" id="drawer-name"></h2>
      <p class="mdrawer__desc" id="drawer-desc"></p>
      <div class="mdrawer__price-row">
        <span class="mdrawer__price" id="drawer-price"></span>
        <button class="mdrawer__note" type="button" id="drawer-note" aria-label="note item">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span data-en="add to list" data-id="tambah ke daftar">add to list</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="menu-data" set:html={JSON.stringify(items)}></script>

<style>
  .menu__card { appearance: none; background: none; border: none; text-align: left; cursor: pointer; padding: 0; }
  .menu { padding: var(--section-py, 5rem) 0; }
  .menu__wrap { max-width: var(--content-width, 1140px); margin: 0 auto; padding: 0 1.5rem; }

  .menu__head { text-align: center; margin-bottom: 2.75rem; }
  .menu__head h2 { text-transform: lowercase; margin: 0.5rem 0; }
  .menu__sub { font-size: 0.875rem; font-weight: 300; color: var(--muted); max-width: 420px; margin: 0 auto; text-transform: lowercase; }

  .menu__nav { display: flex; gap: 0.35rem; flex-wrap: wrap; justify-content: center; margin-bottom: 2.5rem; }
  .menu__navbtn {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.48rem 1.1rem; border-radius: 50px;
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    background: var(--glass, rgba(255,255,255,0.03));
    font-family: var(--font-body); font-size: 0.75rem; font-weight: 400;
    color: var(--muted); cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
    text-transform: lowercase; white-space: nowrap;
  }
  .menu__navbtn:hover { color: var(--cream, #F0E8DC); border-color: rgba(255,255,255,0.15); }
  .menu__navbtn--on {
    background: rgba(201,146,74,0.12);
    border-color: rgba(201,146,74,0.45);
    color: var(--btn-color, #C9924A);
    font-weight: 600;
    box-shadow: 0 2px 16px rgba(201,146,74,0.18);
  }
  .menu__navbtn-count {
    font-size: 0.65rem; background: rgba(255,255,255,0.06);
    border-radius: 50px; padding: 1px 5px; color: var(--muted);
  }
  .menu__navbtn--on .menu__navbtn-count { background: rgba(201,146,74,0.18); color: var(--btn-color, #C9924A); }

  .menu__lane { position: relative; }
  .menu__lane--hidden { display: none; }

  .menu__track {
    display: flex; gap: 1rem; overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0 1.5rem;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .menu__track::-webkit-scrollbar { display: none; }

  .menu__card {
    position: relative; flex: 0 0 172px; scroll-snap-align: start;
    border-radius: 16px; padding: 1.25rem 1rem 1.1rem;
    background: var(--glass, rgba(255,255,255,0.03));
    border: 1px solid var(--border, rgba(255,255,255,0.07));
    display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    overflow: hidden;
  }
  .menu__card:hover { transform: translateY(-3px); border-color: rgba(201,146,74,0.3); box-shadow: 0 8px 28px rgba(0,0,0,0.2); }
  .menu__card:focus-visible { outline: 2px solid #C9924A; outline-offset: 2px; }
  .menu__card:active { transform: scale(0.97); }

  .menu__card-shine {
    position: absolute; inset: 0;
    background: radial-gradient(circle at 50% -10%, rgba(201,146,74,0.07), transparent 60%);
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .menu__card:hover .menu__card-shine { opacity: 1; }

  .menu__tag {
    position: absolute; top: 8px; right: 8px;
    font-size: 0.55rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: lowercase; padding: 2px 7px; border-radius: 50px;
  }
  .menu__tag--bestseller { background: linear-gradient(135deg, #E07A5F, #C9924A); color: #0a0a0a; }
  .menu__tag--new        { background: linear-gradient(135deg, #5bdb83, #38bdf8); color: #0a0a0a; }
  .menu__tag--signature  { background: linear-gradient(135deg, #f4d07a, #C9924A); color: #0a0a0a; }

  .menu__icon-wrap {
    width: 52px; height: 52px; border-radius: 14px;
    background: rgba(255,255,255,0.04);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.25s; flex-shrink: 0;
  }
  .menu__card:hover .menu__icon-wrap { background: rgba(201,146,74,0.08); }
  .menu__icon { color: var(--gold-lt, #E8C97A); display: block; }

  .menu__card-body { display: flex; flex-direction: column; gap: 0.2rem; width: 100%; }
  .menu__card-name { font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; color: var(--cream, #F0E8DC); margin: 0; line-height: 1.35; text-transform: lowercase; }
  .menu__card-size { font-size: 0.6rem; letter-spacing: 0.05em; color: rgba(201,146,74,0.6); border: 1px solid rgba(201,146,74,0.15); border-radius: 50px; padding: 1px 5px; align-self: flex-start; text-transform: lowercase; }
  .menu__card-price { font-family: var(--font-display); font-size: 1rem; font-weight: 500; color: var(--gold-lt, #E8C97A); font-style: italic; margin: 0.15rem 0 0; }

  .menu__arrow {
    position: absolute; top: 50%; transform: translateY(-60%);
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--bg, #0e0d0b); border: 1px solid rgba(255,255,255,0.1);
    color: var(--cream, #F0E8DC); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s; z-index: 3; box-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }
  .menu__arrow--prev { left: -14px; }
  .menu__arrow--next { right: -14px; }
  .menu__arrow:hover { background: rgba(201,146,74,0.1); }
  @media (max-width: 600px) { .menu__arrow { display: none; } }

  /* DRAWER */
  .mdrawer { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; justify-content: center; }
  .mdrawer__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); cursor: pointer; }
  .mdrawer__sheet {
    position: relative; z-index: 1; width: 100%; max-width: 480px;
    background: #141210;
    border-radius: 24px 24px 0 0; border-top: 1px solid rgba(255,255,255,0.08);
    padding: 0 1.75rem 2.5rem; overflow: hidden;
    animation: drawerIn 0.32s cubic-bezier(0.22,1,0.36,1) forwards;
  }
  @keyframes drawerIn  { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes drawerOut { from { transform: translateY(0);    } to { transform: translateY(100%); } }
  .mdrawer--closing .mdrawer__sheet { animation: drawerOut 0.22s ease-in forwards; }

  .mdrawer__sheet::before {
    content: ''; display: block; width: 36px; height: 4px; border-radius: 2px;
    background: rgba(255,255,255,0.12); margin: 0.85rem auto 0;
  }
  .mdrawer__close {
    position: absolute; top: 1.1rem; right: 1.25rem;
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: var(--muted, #888); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, color 0.2s;
  }
  .mdrawer__close:hover { background: rgba(255,255,255,0.1); color: var(--cream, #F0E8DC); }

  .mdrawer__icon-stage { position: relative; display: flex; align-items: center; justify-content: center; height: 110px; margin: 1rem 0 0; }
  .mdrawer__bigicon { color: var(--drawer-color, #E8C97A); position: relative; z-index: 1; filter: drop-shadow(0 4px 16px rgba(201,146,74,0.35)); transition: color 0.3s; }
  .mdrawer__glow-ring { position: absolute; inset: 0; background: radial-gradient(circle, rgba(201,146,74,0.1) 0%, transparent 70%); border-radius: 50%; }

  .mdrawer__body { padding-top: 0.6rem; }
  .mdrawer__meta { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.6rem; }
  .mdrawer__tag { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.06em; text-transform: lowercase; padding: 2px 8px; border-radius: 50px; }
  .mdrawer__tag--bestseller { background: linear-gradient(135deg, #E07A5F, #C9924A); color: #0a0a0a; }
  .mdrawer__tag--new        { background: linear-gradient(135deg, #5bdb83, #38bdf8); color: #0a0a0a; }
  .mdrawer__tag--signature  { background: linear-gradient(135deg, #f4d07a, #C9924A); color: #0a0a0a; }
  .mdrawer__size { font-size: 0.65rem; color: var(--muted, #888); border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; padding: 2px 8px; text-transform: lowercase; }

  .mdrawer__name { font-family: var(--font-body); font-size: 1.35rem; font-weight: 500; color: var(--cream, #F0E8DC); text-transform: lowercase; margin: 0 0 0.55rem; line-height: 1.25; }
  .mdrawer__desc { font-size: 0.83rem; font-weight: 300; color: var(--muted, #888); line-height: 1.65; margin: 0 0 1.25rem; text-transform: lowercase; }

  .mdrawer__price-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .mdrawer__price { font-family: var(--font-display); font-size: 1.75rem; font-weight: 500; color: var(--drawer-color, #E8C97A); font-style: italic; transition: color 0.3s; }
  .mdrawer__note {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.6rem 1.2rem; border-radius: 50px;
    background: rgba(201,146,74,0.1); border: 1px solid rgba(201,146,74,0.3);
    color: #E8C97A; font-family: var(--font-body); font-size: 0.78rem; font-weight: 500;
    cursor: pointer; transition: background 0.2s, box-shadow 0.2s; text-transform: lowercase;
  }
  .mdrawer__note:hover { background: rgba(201,146,74,0.2); box-shadow: 0 4px 14px rgba(201,146,74,0.2); }

  @media (max-width: 540px) {
    .menu__card { flex: 0 0 148px; padding: 1rem 0.85rem; }
    .menu__icon-wrap { width: 44px; height: 44px; }
    .menu__card-name { font-size: 0.75rem; }
    .mdrawer__sheet { padding: 0 1.25rem 2rem; }
    .mdrawer__name { font-size: 1.15rem; }
    .mdrawer__price { font-size: 1.45rem; }
  }
  @media (min-width: 900px) {
    .mdrawer { align-items: center; }
    .mdrawer__sheet { border-radius: 20px; max-width: 440px; }
    .mdrawer__sheet::before { display: none; }
  }

  .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .reveal.in { opacity: 1; transform: none; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var raw = (document.getElementById('menu-data') || {}).textContent || '[]';
  var items = JSON.parse(raw);

  var catColors = {
    'coffee':     '#C9924A',
    'signature':  '#E8A87C',
    'non-coffee': '#7FB069',
    'food':       '#E07A5F',
    'snack':      '#F2CC8F',
    'beer':       '#F4A261'
  };

  var tabs   = document.querySelectorAll('.menu__navbtn');
  var lanes  = document.querySelectorAll('.menu__lane');
  var drawer = document.getElementById('menu-drawer');
  var isOpen = false;
  var currentItem = null;

  // populate counts + apply active style to first tab
  tabs.forEach(function (tab, i) {
    var cat = tab.getAttribute('data-cat');
    var count = items.filter(function (it) { return it.category === cat; }).length;
    var countEl = tab.querySelector('.menu__navbtn-count');
    if (countEl) countEl.textContent = count;
    if (i === 0) activateTab(tab);
  });

  function activateTab(tab) {
    var cat   = tab.getAttribute('data-cat');
    var color = catColors[cat] || '#C9924A';

    tabs.forEach(function (t) {
      t.classList.remove('menu__navbtn--on');
      t.setAttribute('aria-selected', 'false');
      t.style.removeProperty('--btn-color');
    });
    tab.classList.add('menu__navbtn--on');
    tab.setAttribute('aria-selected', 'true');
    tab.style.setProperty('--btn-color', color);

    // update active tab border/shadow colour inline so no color-mix needed
    tab.style.borderColor   = color.replace(')', ', 0.45)').replace('rgb', 'rgba');
    tab.style.boxShadow     = '0 2px 16px ' + hexToRgba(color, 0.18);
    tab.style.background    = hexToRgba(color, 0.10);
    tab.style.color         = color;

    lanes.forEach(function (lane) {
      if (lane.getAttribute('data-lane') === cat) {
        lane.classList.remove('menu__lane--hidden');
      } else {
        lane.classList.add('menu__lane--hidden');
      }
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { activateTab(tab); });
  });

  // arrows
  document.querySelectorAll('.menu__arrow').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var trackId = btn.getAttribute('data-track');
      var track   = document.querySelector('[data-track="' + trackId + '"]');
      if (!track) return;
      var dir = btn.classList.contains('menu__arrow--next') ? 1 : -1;
      track.scrollBy({ left: dir * 300, behavior: 'smooth' });
    });
  });

  // drawer
  function openDrawer(item) {
    currentItem = item;
    var color   = catColors[item.category] || '#C9924A';
    var isID    = document.documentElement.lang === 'id';

    // clone svg paths from the card into the big drawer icon
    var cardIcon = document.querySelector('.menu__card[data-id="' + item.id + '"] .menu__icon');
    var drawerIcon = document.getElementById('drawer-icon');
    if (cardIcon && drawerIcon) {
      drawerIcon.innerHTML = cardIcon.innerHTML;
    }

    // tag
    var tagEl = document.getElementById('drawer-tag');
    if (item.tag) {
      tagEl.style.display = '';
      tagEl.className = 'mdrawer__tag mdrawer__tag--' + item.tag;
      tagEl.textContent = item.tag === 'bestseller' ? 'best seller' : item.tag === 'new' ? 'new' : 'signature';
    } else {
      tagEl.style.display = 'none';
    }

    // size
    var sizeEl = document.getElementById('drawer-size');
    if (item.size) { sizeEl.style.display = ''; sizeEl.textContent = item.size; }
    else           { sizeEl.style.display = 'none'; }

    document.getElementById('drawer-name').textContent  = isID ? item.nameId : item.name;
    document.getElementById('drawer-desc').textContent  = (isID ? item.descId : item.desc) || '';
    document.getElementById('drawer-price').textContent = item.price;

    // colour accents
    var sheet = drawer.querySelector('.mdrawer__sheet');
    sheet.style.setProperty('--drawer-color', color);
    document.getElementById('drawer-price').style.color = color;
    document.getElementById('drawer-icon').style.color  = color;
    var glowRing = drawer.querySelector('.mdrawer__glow-ring');
    if (glowRing) glowRing.style.background = 'radial-gradient(circle, ' + hexToRgba(color, 0.12) + ' 0%, transparent 70%)';

    drawer.style.display = 'flex';
    drawer.classList.remove('mdrawer--closing');
    // restart animation
    sheet.style.animation = 'none';
    void sheet.offsetHeight;
    sheet.style.animation = '';
    document.body.style.overflow = 'hidden';
    isOpen = true;

    setTimeout(function () {
      var closeBtn = drawer.querySelector('.mdrawer__close');
      if (closeBtn) closeBtn.focus();
    }, 60);
  }

  function closeDrawer() {
    if (!isOpen) return;
    drawer.classList.add('mdrawer--closing');
    var sheet = drawer.querySelector('.mdrawer__sheet');
    function onEnd() {
      drawer.style.display = 'none';
      drawer.classList.remove('mdrawer--closing');
      document.body.style.overflow = '';
      isOpen = false;
      sheet.removeEventListener('animationend', onEnd);
    }
    sheet.addEventListener('animationend', onEnd);
  }

  document.querySelectorAll('.menu__card').forEach(function (card) {
    card.addEventListener('click', function () {
      var id   = card.getAttribute('data-id');
      var item = items.find(function (i) { return i.id === id; });
      if (item) openDrawer(item);
    });
  });

  var backdrop = drawer.querySelector('.mdrawer__backdrop');
  var closeBtn = drawer.querySelector('.mdrawer__close');
  var noteBtn  = document.getElementById('drawer-note');

  backdrop.addEventListener('click', closeDrawer);
  closeBtn.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && isOpen) closeDrawer();
  });

  noteBtn.addEventListener('click', function () {
    if (!currentItem) return;
    window.dispatchEvent(new CustomEvent('pc:toast', {
      detail: { type: 'success', title: 'noted! ☕', message: currentItem.name + ' added to your visit list.' }
    }));
    if (window.plausible) window.plausible('Menu Item Click', { props: { item: currentItem.name } });
    closeDrawer();
  });

  // language
  document.addEventListener('pc:lang', function (e) {
    var isID = e.detail && e.detail.isID;
    document.querySelectorAll('[data-en][data-id]').forEach(function (el) {
      var val = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (val !== null) el.textContent = val;
    });
    tabs.forEach(function (tab) {
      var raw = isID ? tab.getAttribute('data-id') : tab.getAttribute('data-en');
      if (raw !== null) {
        var labelEl = tab.querySelector('.menu__navbtn-label');
        if (labelEl) labelEl.textContent = raw;
      }
    });
    if (isOpen && currentItem) openDrawer(currentItem);
  });

  // reveal
  var ro = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(function (el) { ro.observe(el); });

  // hex helper — avoids color-mix entirely
  function hexToRgba(hex, alpha) {
    var r = parseInt(hex.slice(1,3),16);
    var g = parseInt(hex.slice(3,5),16);
    var b = parseInt(hex.slice(5,7),16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

});
</script>