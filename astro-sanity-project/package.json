    "sanity:extract": "cd sanity && sanity dataset export production ./backup.tar.gz",
    "type-check": "astro check",
    "lint": "eslint src --ext .ts,.astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^5.5.4",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "@sanity/client": "^6.22.5",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^5.26.0",
    "@tailwindcss/forms": "^0.5.9",
    "astro": "^4.16.18",
    "sanity": "^5.26.0",
    "tailwind": "^4.0.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@typescript-eslint/parser": "^8.16.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.14.0"
  }
}
