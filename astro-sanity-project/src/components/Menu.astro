---

<!-- ══ MENU ════════════════════════════════════════════════════ -->
<section class="menu pc-section" id="menu" aria-label="our menu">
  <div class="wrap">

    <!-- header -->
    <header class="menu__head reveal">
      <p class="eyebrow" data-en="what we brew" data-id="apa yang kami sajikan">what we brew</p>
      <h2 data-en="the put.in menu" data-id="menu put.in">the put.in menu</h2>
      <p class="menu__sub" data-en="bali highland beans, honest food, ocean breeze — served daily from 7am."
         data-id="biji kopi pegunungan bali, makanan jujur, angin laut — disajikan setiap hari mulai jam 7.">
        bali highland beans, honest food, ocean breeze — served daily from 7am.
      </p>
    </header>

    <!-- tabs -->
    <div class="menu__tabs" role="tablist" aria-label="menu categories">
      {tabs.map((t, i) => (
        <button
          class={`menu__tab${i===0?' menu__tab--on':''}`}
          data-cat={t.id}
          data-en={`${t.icon} ${t.en}`}
          data-id={`${t.icon} ${t.id_}`}
          role="tab"
          aria-selected={i===0?'true':'false'}
        >
          <span class="menu__tab-icon" aria-hidden="true">{t.icon}</span>
          <span class="menu__tab-label">{t.en}</span>
        </button>
      ))}
    </div>

    <!-- grid -->
    <div class="menu__grid" id="menu-grid" role="tabpanel">
      {items.map((item, i) => (
        <article class="menu__card pc-card" data-cat={item.category} aria-label={item.name}>
          {item.tag && (
            <span class={`menu__tag menu__tag--${item.tag}`}>
              {item.tag==='bestseller'?'🔥 best seller':item.tag==='new'?'✨ new':'🌅 signature'}
            </span>
          )}
          <div class="menu__emoji" aria-hidden="true">{item.emoji}</div>
          <div class="menu__info">
            <div class="menu__name-row">
              <h3 class="menu__name" data-en={item.name} data-id={item.nameId}>{item.name}</h3>
              {item.size && <span class="menu__size">{item.size}</span>}
            </div>
            {item.desc && (
              <p class="menu__desc" data-en={item.desc} data-id={item.descId??item.desc}>{item.desc}</p>
            )}
            <div class="menu__foot">
              <span class="menu__price">{item.price}</span>
              <button class="menu__add" aria-label={`note ${item.name}`} data-item={item.name} title="note for visit">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="menu__glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <!-- empty -->
    <p id="menu-empty" class="menu__empty" hidden>
      <span aria-hidden="true">☕</span>
      <span data-en="nothing here yet." data-id="belum ada item.">nothing here yet.</span>
    </p>

  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────────── */
  .menu__head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .menu__head h2 {
    text-transform: lowercase;
    margin: 0.5rem 0;
  }
  .menu__sub {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--muted);
    max-width: 420px;
    margin: 0 auto;
    text-transform: lowercase;
  }

  /* ── Tabs ────────────────────────────────────────────────── */
  .menu__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }
  .menu__tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0.5rem 1.1rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: var(--glass);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.22s ease;
    text-transform: lowercase;
    white-space: nowrap;
  }
  .menu__tab:hover {
    color: var(--cream);
    border-color: rgba(201,146,74,0.2);
  }
  .menu__tab--on {
    background: linear-gradient(135deg, var(--coral), var(--gold));
    border-color: transparent;
    color: var(--bg);
    font-weight: 600;
    box-shadow: 0 2px 14px rgba(201,146,74,0.25);
  }
  .menu__tab--on:hover { color: var(--bg); }
  .menu__tab-icon { font-size: 0.9rem; line-height: 1; }

  /* ── Grid ────────────────────────────────────────────────── */
  .menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1rem;
  }

  /* ── Card ────────────────────────────────────────────────── */
  .menu__card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .menu__card[hidden] { display: none; }
  .menu__card:hover .menu__glow { opacity: 1; }
  .menu__card:hover .menu__emoji { transform: scale(1.06) rotate(-2deg); }
  .menu__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(201,146,74,0.05), transparent 65%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }

  /* tag */
  .menu__tag {
    position: absolute;
    top: 8px; right: 8px;
    font-family: var(--font-body);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    padding: 0.25rem 0.6rem;
    border-radius: 50px;
    z-index: 2;
  }
  .menu__tag--bestseller { background: linear-gradient(135deg, var(--coral), var(--gold)); color: var(--bg); }
  .menu__tag--new        { background: linear-gradient(135deg, #5bdb83, #38bdf8);         color: var(--bg); }
  .menu__tag--signature  { background: linear-gradient(135deg, var(--gold-lt), var(--gold)); color: var(--bg); }

  /* emoji */
  .menu__emoji {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    background: rgba(255,255,255,0.02);
    flex-shrink: 0;
    transition: transform 0.3s;
  }

  /* info */
  .menu__info {
    padding: 0.9rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .menu__name-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .menu__name {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--cream);
    margin: 0;
    line-height: 1.3;
    text-transform: lowercase;
    flex: 1;
  }
  .menu__size {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: rgba(201,146,74,0.65);
    border: 1px solid rgba(201,146,74,0.18);
    border-radius: 50px;
    padding: 1px 6px;
    flex-shrink: 0;
    white-space: nowrap;
    margin-top: 1px;
    text-transform: lowercase;
  }
  .menu__desc {
    font-size: 0.74rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
    flex: 1;
    text-transform: lowercase;
  }
  .menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(240,232,220,0.05);
    margin-top: auto;
  }
  .menu__price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--gold-lt);
    font-style: italic;
  }
  .menu__add {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(201,146,74,0.25);
    background: rgba(201,146,74,0.04);
    color: var(--gold);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.25s, box-shadow 0.2s;
    flex-shrink: 0;
  }
  .menu__add:hover {
    background: linear-gradient(135deg, var(--coral), var(--gold));
    color: var(--bg);
    border-color: transparent;
    transform: rotate(90deg) scale(1.1);
    box-shadow: 0 3px 10px rgba(201,146,74,0.3);
  }

  /* empty */
  .menu__empty {
    text-align: center;
    padding: 3rem;
    color: var(--muted);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
  }
  .menu__empty span:last-child { font-size: 0.85rem; }

  /* responsive */
  @media (max-width: 540px) {
    .menu__grid { grid-template-columns: 1fr 1fr; gap: 0.65rem; }
    .menu__emoji { height: 64px; font-size: 1.8rem; }
    .menu__desc { display: none; }
    .menu__info { padding: 0.65rem 0.75rem 0.75rem; }
  }
  @media (max-width: 360px) {
    .menu__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  const tabs  = document.querySelectorAll<HTMLButtonElement>('.menu__tab');
  const cards = document.querySelectorAll<HTMLElement>('.menu__card');
  const empty = document.getElementById('menu-empty')!;

  function stagger(visible: HTMLElement[]) {
    visible.forEach((c, i) => {
      c.style.animationDelay = `${i * 0.035}s`;
      c.style.animationName = 'none';
      void c.offsetHeight;
      c.style.animationName = '';
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat!;
      tabs.forEach(t => { t.classList.remove('menu__tab--on'); t.setAttribute('aria-selected','false'); });
      tab.classList.add('menu__tab--on');
      tab.setAttribute('aria-selected','true');

      const vis: HTMLElement[] = [];
      cards.forEach(c => {
        const show = cat === 'all' || c.dataset.cat === cat;
        c.hidden = !show;
        if (show) vis.push(c);
      });
      empty.hidden = vis.length > 0;
      stagger(vis);
    });
  });

  tabs[0]?.click();

  // add to visit note
  document.querySelectorAll<HTMLButtonElement>('.menu__add').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.item!;
      window.dispatchEvent(new CustomEvent('pc:toast', { detail:{ type:'success', title:'noted! ☕', message:`${name} added to your visit list.` } }));
      // @ts-ignore
      if (window.plausible) window.plausible('Menu Item Click', { props:{ item: name } });
    });
  });

  // language
  document.addEventListener('pc:lang', ((e: CustomEvent) => {
    const isID = e.detail.isID as boolean;
    document.querySelectorAll<HTMLElement>('[data-en][data-id]').forEach(el => {
      const val = isID ? el.dataset.id : el.dataset.en;
      if (val !== undefined) el.textContent = val;
    });
    tabs.forEach(tab => {
      const raw = isID ? tab.dataset.id : tab.dataset.en;
      if (!raw) return;
      const [icon, ...rest] = raw.split(' ');
      const iconEl = tab.querySelector('.menu__tab-icon');
      const labelEl = tab.querySelector('.menu__tab-label');
      if (iconEl) iconEl.textContent = icon;
      if (labelEl) labelEl.textContent = rest.join(' ');
    });
  }) as EventListener);

  // reveal on scroll
  const ro = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
</script>