---
// src/components/Reviews.astro
import type { Review, SiteSettings } from '../types/index.ts';

export interface Props {
  reviews: Review[];
  settings: Partial<SiteSettings>;
}

const { reviews, settings } = Astro.props;
const totalReviews = settings?.totalReviews ?? 49;
const avgRating    = settings?.averageRating ?? 5.0;
const googleUrl    = settings?.reviewsGoogleUrl ?? 'https://maps.google.com/search?q=Putin+Coffee+Pantai+Biaung+Sanur';
---

<!-- ══ REVIEWS ════════════════════════════════════════════════ -->
<section class="section bg-pc-bg" id="reviews" aria-label="Customer reviews">
  <div class="container">

    <!-- Header -->
    <div class="text-center mb-16">
      <!-- Google badge -->
      <div class="reveal inline-flex items-center gap-2 bg-white/[0.04] border border-white/[0.08] rounded-pill px-4 py-2 mb-6">
        <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span class="eyebrow" style="margin:0">Verified on Google</span>
      </div>

      <!-- Score -->
      <div class="reveal flex items-center justify-center gap-4 mb-4">
        <span class="font-display text-6xl text-pc-cream leading-none">{avgRating.toFixed(1)}</span>
        <div class="flex flex-col items-start">
          <div class="flex" aria-label="5 stars out of 5">
            {[...Array(5)].map(() => <span class="text-pc-star text-xl">★</span>)}
          </div>
          <span class="text-pc-muted text-sm mt-0.5">Based on {totalReviews} Google Reviews</span>
        </div>
      </div>

      <h2 class="text-pc-cream mb-4 reveal">What Our Guests Say</h2>
      <p class="text-pc-muted text-lg max-w-md mx-auto reveal">
        Every story shared here is a real experience. These are the words that fuel us every morning.
      </p>
    </div>

    <!-- Reviews grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {reviews.map((review, i) => (
        <article
          class="card relative overflow-hidden p-6 reveal"
          style={`transition-delay: ${(i % 3) * 100}ms`}
        >
          <!-- Quote decoration -->
          <div class="absolute top-0 left-4 font-display text-[7rem] leading-none text-white/[0.04] select-none pointer-events-none" aria-hidden="true">"</div>

          <!-- Stars -->
          <div class="flex mb-4" aria-label={`${review.rating} stars`}>
            {[...Array(review.rating)].map(() => (
              <span class="text-pc-star text-sm">★</span>
            ))}
          </div>

          <!-- Text -->
          <p class="text-pc-text text-sm leading-relaxed mb-6 line-clamp-5">"{review.reviewText}"</p>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <!-- Avatar -->
            <div
              class={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-[#0a0800] bg-gradient-to-br flex-shrink-0 ${review.avatarGradient}`}
              aria-hidden="true"
            >
              {review.avatarInitial}
            </div>

            <div>
              <p class="text-sm font-semibold text-pc-cream">{review.authorName}</p>
              <p class="text-xs text-pc-muted">{review.authorLocation} · {review.visitDate}</p>
              {review.isVerified && (
                <p class="text-[10px] text-pc-green flex items-center gap-1 mt-0.5">
                  <span>✓</span> Verified Google Review
                </p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 reveal">
      <a
        href={googleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-ghost"
        data-event="Google Reviews Click"
      >
        Read All {totalReviews}+ Reviews on Google →
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelector('[data-event="Google Reviews Click"]')?.addEventListener('click', () => {
    // @ts-ignore
    if (window.plausible) window.plausible('Google Reviews Click');
  });
</script>