---

<!-- ══ MENU ═══════════════════════════════════════════════════ -->
<section class="menu-section" id="menu" aria-label="Our menu">

  <!-- Top wave transition -->
  <div class="menu-section__wave-top" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path d="M0,0 C300,60 900,0 1200,40 L1200,0 Z" fill="#09070F"/>
    </svg>
  </div>

  <div class="menu-section__inner">

    <!-- ── Section header ─────────────────────────────────── -->
    <header class="menu-header">
      <p class="menu-eyebrow">
        <span data-en="What We Brew" data-id="Apa yang Kami Sajikan">What We Brew</span>
      </p>
      <h2 class="menu-title">
        <span data-en="The put.in Coffee Menu" data-id="Menu put.in Coffee">The put.in Coffee Menu</span>
      </h2>
      <p class="menu-sub">
        <span data-en="Specialty coffee crafted from Bali highland beans, honest food made with love — served with ocean breeze."
              data-id="Kopi spesialti dari biji kopi pegunungan Bali, makanan jujur dibuat dengan cinta — disajikan dengan angin laut.">
          Specialty coffee crafted from Bali highland beans, honest food made with love — served with ocean breeze.
        </span>
      </p>
    </header>

    <!-- ── Tabs ───────────────────────────────────────────── -->
    <div class="menu-tabs" role="tablist" aria-label="Menu categories" id="menu-tabs">
      {tabs.map((tab, i) => (
        <button
          class={`menu-tab${i === 0 ? ' menu-tab--active' : ''}`}
          data-category={tab.id}
          data-en={`${tab.icon} ${tab.label}`}
          data-id={`${tab.icon} ${tab.labelId}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="menu-grid"
        >
          <span class="menu-tab__icon" aria-hidden="true">{tab.icon}</span>
          <span class="menu-tab__label">{tab.label}</span>
        </button>
      ))}
    </div>

    <!-- ── Cards grid ─────────────────────────────────────── -->
    <div class="menu-grid" id="menu-grid" role="tabpanel">
      {menuItems.map((item, i) => (
        <article
          class="menu-card"
          data-category={item.category}
          data-i={i}
          aria-label={item.name}
        >
          <!-- Tag badge -->
          {item.tag && (
            <div class={`menu-card__tag menu-card__tag--${item.tag}`}>
              {item.tag === 'bestseller' ? '🔥 Best Seller' :
               item.tag === 'new'        ? '✨ New'          :
                                           '🌅 Signature'}
            </div>
          )}

          <!-- Emoji -->
          <div class="menu-card__emoji" aria-hidden="true">{item.emoji}</div>

          <!-- Info -->
          <div class="menu-card__body">
            <div class="menu-card__header-row">
              <h3 class="menu-card__name" data-en={item.name} data-id={item.nameId}>{item.name}</h3>
              {item.note && (
                <span class="menu-card__size" aria-label={`Size: ${item.note}`}>{item.note}</span>
              )}
            </div>

            {item.description && (
              <p class="menu-card__desc" data-en={item.description} data-id={item.descriptionId ?? item.description}>
                {item.description}
              </p>
            )}

            <div class="menu-card__footer">
              <span class="menu-card__price">{item.price}</span>
              <button
                class="menu-card__add"
                aria-label={`Add ${item.name}`}
                data-item={item.name}
                title="Add to order"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Hover glow -->
          <div class="menu-card__glow" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <!-- Empty state -->
    <div id="menu-empty" class="menu-empty" hidden>
      <span class="menu-empty__icon">☕</span>
      <p data-en="No items in this category yet." data-id="Belum ada item di kategori ini.">
        No items in this category yet.
      </p>
    </div>

  </div>
</section>

<!-- ══ STYLES ════════════════════════════════════════════════ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap');

  /* ── Section ────────────────────────────────────────────── */
  .menu-section {
    position: relative;
    background: #09070F;
    padding-bottom: 6rem;
  }
  .menu-section__wave-top {
    position: relative;
    height: 60px;
    margin-top: -2px;
    line-height: 0;
  }
  .menu-section__wave-top svg { width: 100%; height: 100%; }
  .menu-section__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  /* ── Header ─────────────────────────────────────────────── */
  .menu-header { text-align: center; margin-bottom: 3rem; }
  .menu-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #F7931E;
    margin-bottom: 0.75rem;
  }
  .menu-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 500;
    color: #FDF6EC;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }
  .menu-sub {
    font-family: 'Jost', sans-serif;
    font-size: 0.95rem;
    font-weight: 300;
    color: rgba(253,246,236,0.5);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Tabs ───────────────────────────────────────────────── */
  .menu-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }
  .menu-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.55rem 1.2rem;
    border-radius: 50px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
    font-family: 'Jost', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(253,246,236,0.5);
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }
  .menu-tab:hover {
    color: #FDF6EC;
    border-color: rgba(255,255,255,0.18);
    background: rgba(255,255,255,0.06);
  }
  .menu-tab--active {
    background: linear-gradient(135deg, #FF6B35, #F7931E);
    border-color: transparent;
    color: #09070F;
    font-weight: 600;
    box-shadow: 0 4px 16px rgba(247,147,30,0.35);
  }
  .menu-tab--active:hover {
    color: #09070F;
    border-color: transparent;
    background: linear-gradient(135deg, #FF6B35, #F7931E);
  }
  .menu-tab__icon { font-size: 0.95rem; line-height: 1; }

  /* ── Grid ───────────────────────────────────────────────── */
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  /* ── Card ───────────────────────────────────────────────── */
  .menu-card {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), border-color 0.3s, box-shadow 0.3s;
    cursor: default;
    animation: card-in 0.5s cubic-bezier(0.4,0,0.2,1) both;
  }
  @keyframes card-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .menu-card:hover {
    transform: translateY(-4px);
    border-color: rgba(247,147,30,0.25);
    box-shadow: 0 12px 40px rgba(255,107,53,0.1), 0 0 0 1px rgba(247,147,30,0.1);
  }
  .menu-card:hover .menu-card__glow { opacity: 1; }

  .menu-card__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(247,147,30,0.06), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }

  /* Tag */
