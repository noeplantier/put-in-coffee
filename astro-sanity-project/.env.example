# ══════════════════════════════════════════════════════════════
#  put.in coffee — Environment variables template
#  Copy to .env and fill in your real values.
#  NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════

# ── Sanity CMS (if used) ──────────────────────────────────
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_read_only_token_here

# ── Plausible Analytics ───────────────────────────────────
PUBLIC_PLAUSIBLE_DOMAIN=www.putincoffee.com

# ── Netlify Forms (no key needed — handled by Netlify) ────
# Form name in HTML: name="reservation"

# ── Contact info (used in components if pulled from env) ──
PUBLIC_WHATSAPP=6281916334989
PUBLIC_INSTAGRAM=put.in.coffee
PUBLIC_TIKTOK=put.in_coffee
PUBLIC_MAPS_URL=https://www.google.com/maps/place/put.in+coffee+and+beer/data=!4m2!3m1!1s0x0:0x70829e134ab3dd00

