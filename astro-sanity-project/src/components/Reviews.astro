---
// src/components/Reviews.astro
// Reviews section · refined · lowercase · EN / ID

import type { Review, SiteSettings } from '../types/index.ts';
export interface Props { reviews: Review[]; settings: Partial<SiteSettings>; }
const { reviews, settings } = Astro.props;

const total      = settings?.totalReviews   ?? 49;
const avg        = settings?.averageRating  ?? 4.9;
const googleUrl  = settings?.reviewsGoogleUrl ?? 'https://maps.google.com/search?q=Putin+Coffee+Pantai+Biaung+Sanur';

// Fallback sample reviews if none provided
const displayReviews = reviews?.length ? reviews : [
  {
    id:'r1', rating:5, reviewText:"honestly one of the most magical coffee experiences i've had. the view, the vibe, the coffee — all perfect. the ice blonde is next level.",
    authorName:"sophie t.", authorLocation:"australia", visitDate:"april 2025", isVerified:true,
    avatarInitial:"S", avatarGradient:"from-amber-400 to-orange-500"
  },
  {
    id:'r2', rating:5, reviewText:"we came for sunset and ended up staying until they closed. the nasi ayam lengkuas is incredible. this is sanur's best kept secret.",
    authorName:"marco v.", authorLocation:"italy", visitDate:"march 2025", isVerified:true,
    avatarInitial:"M", avatarGradient:"from-rose-400 to-pink-600"
  },
  {
    id:'r3', rating:5, reviewText:"perfect beachfront spot. staff are so warm and friendly, coffee is seriously good, and the prices are very fair. already planning our return.",
    authorName:"anika r.", authorLocation:"germany", visitDate:"may 2025", isVerified:true,
    avatarInitial:"A", avatarGradient:"from-teal-400 to-cyan-600"
  },
  {
    id:'r4', rating:5, reviewText:"we found put.in coffee by accident and it became the highlight of our bali trip. the signature drinks are so unique. loved every sip.",
    authorName:"james k.", authorLocation:"united states", visitDate:"february 2025", isVerified:true,
    avatarInitial:"J", avatarGradient:"from-violet-400 to-purple-600"
  },
  {
    id:'r5', rating:5, reviewText:"watching the sun set over the ocean with an ice beige in hand — that's what life is about. do not miss this place if you're in sanur.",
    authorName:"lisa m.", authorLocation:"netherlands", visitDate:"april 2025", isVerified:true,
    avatarInitial:"L", avatarGradient:"from-emerald-400 to-green-600"
  },
  {
    id:'r6', rating:5, reviewText:"the tower beer with friends at sunset while listening to live music — doesn't get better than this. 100% will be back.",
    authorName:"budi s.", authorLocation:"jakarta, indonesia", visitDate:"may 2025", isVerified:true,
    avatarInitial:"B", avatarGradient:"from-yellow-400 to-amber-600"
  },
];
---

<!-- ══ REVIEWS ════════════════════════════════════════════════ -->
<section class="revs pc-section" id="reviews" aria-label="guest reviews">
  <div class="wrap">

    <!-- header -->
    <header class="revs__head reveal">
      <p class="eyebrow" data-en="what guests say" data-id="kata tamu kami">what guests say</p>
      <h2 data-en="real words, real moments" data-id="kata nyata, momen nyata">real words, real moments</h2>

      <!-- score bar -->
      <div class="revs__score">
        <!-- google badge -->
        <div class="revs__google-badge" aria-label="verified on google">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>verified on google</span>
        </div>

        <!-- stars + number -->
        <div class="revs__rating">
          <span class="revs__rating-num">{avg.toFixed(1)}</span>
          <div>
            <div class="revs__stars" aria-label={`${avg} stars out of 5`}>
              {[1,2,3,4,5].map(() => <span aria-hidden="true">★</span>)}
            </div>
            <span class="revs__rating-count"
                  data-en={`based on ${total} reviews`}
                  data-id={`dari ${total} ulasan`}>
              based on {total} reviews
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- cards grid -->
    <div class="revs__grid">
      {displayReviews.map((r, i) => (
        <article
          class="revs__card pc-card reveal"
          style={`transition-delay:${(i%3)*0.07}s`}
          aria-label={`review by ${r.authorName}`}
        >
          <!-- quote mark decoration -->
          <span class="revs__quote" aria-hidden="true">"</span>

          <!-- stars -->
          <div class="revs__card-stars" aria-label={`${r.rating} stars`}>
            {Array.from({length: r.rating}).map(() => <span aria-hidden="true">★</span>)}
          </div>

          <!-- text -->
          <p class="revs__text">"{r.reviewText}"</p>

          <!-- author -->
          <div class="revs__author">
            <div class={`revs__avatar bg-gradient-to-br ${r.avatarGradient}`} aria-hidden="true">
              {r.avatarInitial}
            </div>
            <div class="revs__author-info">
              <span class="revs__author-name">{r.authorName}</span>
              <span class="revs__author-meta">{r.authorLocation} · {r.visitDate}</span>
              {r.isVerified && (
                <span class="revs__verified">✓ verified google review</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- cta -->
    <div class="revs__cta reveal">
      <a
        href={googleUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
        data-en={`read all ${total}+ reviews on google →`}
        data-id={`baca semua ${total}+ ulasan di google →`}
      >
        read all {total}+ reviews on google →
      </a>
    </div>

  </div>
</section>

<style>
  /* ── Header ──────────────────────────────────────────────── */
  .revs__head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .revs__head h2 {
    text-transform: lowercase;
    margin: 0.4rem 0 1.5rem;
  }

  /* google badge + score */
  .revs__score {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .revs__google-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--muted);
    text-transform: lowercase;
  }
  .revs__rating {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .revs__rating-num {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 400;
    color: var(--cream);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .revs__stars {
    display: flex;
    gap: 2px;
    color: var(--gold);
    font-size: 1rem;
    margin-bottom: 2px;
  }
  .revs__rating-count {
    font-size: 0.72rem;
    font-weight: 300;
    color: var(--muted);
    text-transform: lowercase;
  }

  /* ── Grid ────────────────────────────────────────────────── */
  .revs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Card ────────────────────────────────────────────────── */
  .revs__card {
    position: relative;
    padding: 1.5rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .revs__quote {
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: rgba(201,146,74,0.07);
    pointer-events: none;
    user-select: none;
    font-style: italic;
  }
  .revs__card-stars {
    display: flex;
    gap: 2px;
    color: var(--gold);
    font-size: 0.78rem;
  }
  .revs__text {
    font-size: 0.84rem;
    font-weight: 300;
    color: var(--cream-dk);
    line-height: 1.65;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-transform: lowercase;
  }
  .revs__author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(240,232,220,0.05);
    margin-top: auto;
  }
  .revs__avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: #0b0908;
    flex-shrink: 0;
  }
  .revs__author-info { display: flex; flex-direction: column; gap: 1px; }
  .revs__author-name {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--cream);
    text-transform: lowercase;
  }
  .revs__author-meta {
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--muted);
    text-transform: lowercase;
  }
  .revs__verified {
    font-size: 0.62rem;
    font-weight: 400;
    color: #5bdb83;
    text-transform: lowercase;
  }

  /* ── CTA ─────────────────────────────────────────────────── */
  .revs__cta {
    text-align: center;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 600px) {
    .revs__grid { grid-template-columns: 1fr; }
    .revs__rating-num { font-size: 2.8rem; }
  }
</style>

<script>
  // language
  document.addEventListener('pc:lang', ((e: CustomEvent) => {
    const isID = e.detail.isID as boolean;
    document.querySelectorAll<HTMLElement>('.revs [data-en][data-id]').forEach(el => {
      const val = isID ? el.dataset.id : el.dataset.en;
      if (val !== undefined) el.textContent = val;
    });
  }) as EventListener);

  // reveal
  const ro = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.revs .reveal').forEach(el => ro.observe(el));

  // plausible
  document.querySelector('[href*="google"]')?.addEventListener('click', () => {
    // @ts-ignore
    if (window.plausible) window.plausible('Google Reviews Click');
  });
</script>