---
// src/pages/index.astro
// put.in coffee · home page · EN / ID · v3

import BaseLayout       from '../layouts/BaseLayout.astro';
import Hero             from '../components/Hero.astro';
import Menu             from '../components/Menu.astro';
import Reviews          from '../components/Reviews.astro';
import ReservationForm  from '../components/ReservationForm.astro';
import UI               from '../components/UI.astro';

import {
  getSiteSettings, getMenuItems, getReviews,
  getExperienceFeatures, validateSanityConfig,
} from '../lib/sanity.ts';
import {
  fallbackSettings, fallbackMenuItems,
  fallbackReviews, fallbackFeatures,
} from '../lib/fallback.ts';

const isSanityReady = validateSanityConfig();
const [sanitySettings, sanityMenu, sanityReviews, sanityFeatures] = isSanityReady
  ? await Promise.all([getSiteSettings(), getMenuItems(), getReviews(), getExperienceFeatures()])
  : [null, [], [], []];

const settings  = { ...fallbackSettings, ...sanitySettings };
const menuItems = sanityMenu.length    > 0 ? sanityMenu    : fallbackMenuItems;
const reviews   = sanityReviews.length > 0 ? sanityReviews : fallbackReviews;
const features  = sanityFeatures.length > 0 ? sanityFeatures : fallbackFeatures;

// ── About photo carousel ─────────────────────────────────────
const photos = [
  {
    src: '/put.in1.jpeg',
    en:  { caption: 'terrace at dawn', desc: 'First light over Pantai Biaung — the tables are set, the tide is coming in.' },
    id_: { caption: 'teras saat fajar', desc: 'Cahaya pertama di Pantai Biaung — meja sudah siap, ombak mulai datang.' },
  },
  {
    src: '/put.in2.jpeg',
    en:  { caption: 'the bar', desc: 'Our espresso bar — where every order is pulled fresh, one cup at a time.' },
    id_: { caption: 'area bar', desc: 'Bar espresso kami — setiap pesanan diseduh segar, satu cangkir per waktu.' },
  },
  {
    src: '/put.in3.jpeg',
    en:  { caption: 'ocean view', desc: 'Uninterrupted 180° Indian Ocean from every seat on the terrace.' },
    id_: { caption: 'pemandangan laut', desc: 'Samudra Hindia 180° tanpa halangan dari setiap kursi di teras.' },
  },
  {
    src: '/put.in4.jpeg',
    en:  { caption: 'our signature drinks', desc: 'The ice beige and ice blonde — house originals you won\'t find anywhere else.' },
    id_: { caption: 'minuman andalan kami', desc: 'Es beige dan es blonde — kreasi asli put.in yang tak akan kamu temukan di tempat lain.' },
  },
  {
    src: '/put.in5.jpeg',
    en:  { caption: 'sunset hour', desc: 'When the sky turns amber over Nusa Penida — the golden hour is worth the wait.' },
    id_: { caption: 'saat matahari terbenam', desc: 'Ketika langit berubah keemasan di atas Nusa Penida — momen ini selalu sepadan.' },
  },
  {
    src: '/put.in6.jpeg',
    en:  { caption: 'the vibe', desc: 'Low music, salt air, cold drink in hand. This is why people stay longer than they planned.' },
    id_: { caption: 'suasananya', desc: 'Musik pelan, udara asin, minuman dingin di tangan. Inilah mengapa orang selalu betah lebih lama.' },
  },
];

// ── Experience features (carousel) ──────────────────────────
const expFeatures = [
  {
    id: 'beachfront',
    icon: `<path d="M3 17c2-4 5-7 9-7s7 3 9 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M1 20h22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M12 10V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="4" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
    en:  { label: 'Beachfront Tables', title: 'Your table, the sea, nothing between', body: 'Sit close enough to hear the tide. Our terrace opens directly onto Pantai Biaung — the wild, uncrowded stretch of black-sand coast where fishing boats still pull ashore at dawn. No fence, no barrier, just the Indian Ocean and your coffee.' },
    id_: { label: 'Meja di Tepi Pantai', title: 'Mejamu, lautan, tak ada yang menghalangi', body: 'Duduk cukup dekat untuk mendengar ombak. Teras kami langsung menghadap Pantai Biaung — hamparan pantai berpasir hitam yang liar dan sepi, tempat perahu nelayan masih menepi saat fajar. Tak ada pagar, tak ada penghalang — hanya Samudra Hindia dan kopimu.' },
    stat: { value: '180°', label: { en: 'ocean view', id_: 'pemandangan laut' } },
    accent: '#4A9CA8',
  },
  {
    id: 'roastery',
    icon: `<path d="M8 3h8l1 5H7L8 3z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M7 8c0 5 1.5 9 5 9s5-4 5-9" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 14c.5-1 2.5-1 3 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`,
    en:  { label: 'Specialty Roastery', title: 'Bali in every cup, no shortcuts', body: 'We source green beans from smallholder farms in Kintamani and Munduk — Bali\'s volcanic highlands where altitude and volcanic soil produce a cup with natural sweetness and low bitterness. Roasted in-house weekly. What you drink was probably roasted this week.' },
    id_: { label: 'Roastery Spesial', title: 'Bali di setiap tegukan, tanpa jalan pintas', body: 'Kami memilih biji hijau dari petani kecil di Kintamani dan Munduk — dataran tinggi vulkanik Bali di mana ketinggian dan tanah vulkanik menghasilkan cita rasa manis alami dengan kepahitan rendah. Sangrai langsung di sini setiap minggu. Kopi yang kamu minum kemungkinan besar baru disangrai pekan ini.' },
    stat: { value: '1200m', label: { en: 'altitude grown', id_: 'ditanam di ketinggian' } },
    accent: '#C9924A',
  },
  {
    id: 'sunset',
    icon: `<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    en:  { label: 'Sunset Sessions', title: 'The hour when the whole sky turns gold', body: 'Every evening, when the sun drops over the strait toward Nusa Penida, Pantai Biaung turns amber. We keep a cold beer cold and a warm latte warm for that exact moment. Friday and Saturday evenings bring live acoustic sets — local musicians, no PA overkill, just music you can still talk through.' },
    id_: { label: 'Sesi Matahari Terbenam', title: 'Saat seluruh langit berubah menjadi emas', body: 'Setiap sore, saat matahari turun ke selat menuju Nusa Penida, Pantai Biaung berubah menjadi keemasan. Kami menyiapkan bir dingin dan latte hangat tepat untuk momen itu. Jumat dan Sabtu sore ada penampilan akustik live — musisi lokal, tanpa PA berlebihan, sekadar musik yang tetap bisa kamu ajak bicara.' },
    stat: { value: 'Fri – Sat', label: { en: 'live acoustic', id_: 'musik akustik live' } },
    accent: '#E8A87C',
  },
  {
    id: 'nomad',
    icon: `<rect x="3" y="5" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M8 5V4a1 1 0 011-1h6a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="11.5" r="2" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M8.5 15.5a4 4 0 017 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>`,
    en:  { label: 'Remote-Work Ready', title: "Ocean views don't have to mean bad WiFi", body: 'We run a dedicated 100 Mbps fibre line — not a shared residential line — and keep the password on the table. Power sockets at every inside seat. Plenty of shade on the terrace for screen-readable conditions. Come for a quick coffee, stay for the whole sprint.' },
    id_: { label: 'Siap untuk Remote Work', title: 'Pemandangan laut bukan berarti WiFi lemot', body: 'Kami menggunakan jalur serat optik 100 Mbps khusus — bukan jalur residensial berbagi — dan password selalu ada di meja. Colokan listrik di setiap kursi dalam. Banyak naungan di teras agar layar tetap terbaca. Datang untuk kopi cepat, bertahan untuk seluruh sesi kerja.' },
    stat: { value: '100 Mbps', label: { en: 'dedicated fibre', id_: 'serat optik khusus' } },
    accent: '#7FB069',
  },
  {
    id: 'events',
    icon: `<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    en:  { label: 'Private Events', title: 'The ocean as your backdrop, always', body: "Birthdays, elopements, team retreats, product launches — we've hosted them all with the same beachfront backdrop and the same unhurried service. The space holds up to 80 guests. Catering, decoration coordination, and a full drinks programme can be arranged. Enquire for a bespoke quote." },
    id_: { label: 'Acara Privat', title: 'Lautan sebagai latarmu, selalu', body: 'Ulang tahun, elopement, team retreat, peluncuran produk — semua pernah kami adakan dengan latar pantai yang sama dan pelayanan yang sama tenangnya. Kapasitas hingga 80 tamu. Katering, koordinasi dekorasi, dan program minuman lengkap bisa diatur. Hubungi kami untuk penawaran khusus.' },
    stat: { value: '80', label: { en: 'guests max', id_: 'tamu maks' } },
    accent: '#E07A5F',
  },
];

// ── About stats ──────────────────────────────────────────────
const aboutStats = [
  { value: '5★',  en: 'Google Rating',   id_: 'Rating Google' },
  { value: '49+', en: 'Reviews',          id_: 'Ulasan' },
  { value: 'Bali',en: 'Highland Beans',  id_: 'Biji Kopi Pegunungan' },
  { value: '7am', en: 'Opens Daily',      id_: 'Buka Setiap Hari' },
];
---

<BaseLayout title={`${settings.siteName}`} description={settings.description}>
  <Hero settings={settings} />


  <!-- ══ ABOUT ═════════════════════════════════════════════════ -->
  <section class="pc-section" id="about" aria-label="Our story">
    <div class="pc-container">
      <div class="about__grid">

        <!-- Photo carousel -->
        <div class="about__carousel reveal-scale" id="about-carousel" aria-label="put.in coffee photos" role="region">

          <!-- Slides -->
          <div class="about__slides" id="about-track">
            {photos.map((p, i) => (
              <div
                class={`about__slide${i === 0 ? ' about__slide--active' : ''}`}
                data-slide={i}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <img
                  src={p.src}
                  alt={p.en.caption}
                  class="about__slide-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  data-en-alt={p.en.caption}
                  data-id-alt={p.id_.caption}
                />
                <!-- Caption overlay -->
                <div class="about__caption">
                  <span class="about__caption-tag" data-en={p.en.caption} data-id={p.id_.caption}>{p.en.caption}</span>
                  <p class="about__caption-desc" data-en={p.en.desc} data-id={p.id_.desc}>{p.en.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Controls -->
          <div class="about__controls">
            <!-- Thumbnails -->
            <div class="about__thumbs" role="tablist" aria-label="Photo thumbnails">
              {photos.map((p, i) => (
                <button
                  class={`about__thumb${i === 0 ? ' about__thumb--on' : ''}`}
                  data-goto={i}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={p.en.caption}
                  type="button"
                >
                  <img src={p.src} alt="" loading="lazy" decoding="async" class="about__thumb-img"/>
                </button>
              ))}
            </div>

            <!-- Counter + arrows -->
            <div class="about__nav-row">
              <span class="about__counter">
                <span id="about-current">1</span>
                <span class="about__counter-sep">/</span>
                <span class="about__counter-total">{photos.length}</span>
              </span>
              <div class="about__arrows">
                <button class="about__arrow" id="about-prev" type="button" aria-label="Previous photo">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="about__arrow" id="about-next" type="button" aria-label="Next photo">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Text -->
        <div class="about__text-col">
          <p class="eyebrow reveal" data-en="Our Story" data-id="Kisah Kami">Our Story</p>
          <h2 class="about__h2 reveal"
              data-en="Born from the Waves,<br>Brewed with Soul"
              data-id="Lahir dari Ombak,<br>Diseduh dengan Jiwa">
            Born from the Waves,<br>Brewed with Soul
          </h2>
          <div class="about__prose">
            <p data-en="put.in was born from a simple dream: bring world-class specialty coffee to the most breathtaking stretch of Denpasar's coastline. On the wild black-sand shores of Pantai Biaung, where fishing boats rest and sunsets turn the sky amber — we built our haven."
               data-id="put.in lahir dari mimpi sederhana: menghadirkan kopi spesial kelas dunia ke pantai Denpasar yang paling memukau. Di tepian Pantai Biaung yang liar berpasir hitam, tempat perahu nelayan beristirahat dan matahari terbenam mewarnai langit keemasan — kami membangun surga kami.">
              put.in was born from a simple dream: bring world-class specialty coffee to the most breathtaking stretch of Denpasar's coastline. On the wild black-sand shores of Pantai Biaung, where fishing boats rest and sunsets turn the sky amber — we built our haven.
            </p>
            <p data-en="Every cup we craft honours the ritual of the sea. Our beans are sourced from Bali's highland farms, roasted in-house, and brewed with the patience of the tides."
               data-id="Setiap cangkir yang kami hadirkan menghormati ritual laut. Biji kopi kami berasal dari ladang dataran tinggi Bali, disangrai langsung di sini, dan diseduh dengan kesabaran seperti pasang surut.">
              Every cup we craft honours the ritual of the sea. Our beans are sourced from Bali's highland farms, roasted in-house, and brewed with the patience of the tides.
            </p>
          </div>
          <div class="about__stats">
            {aboutStats.map((s, i) => (
              <div class="about__stat reveal" style={`transition-delay:${80 + i * 60}ms`}>
                <span class="about__stat-value">{s.value}</span>
                <span class="about__stat-label" data-en={s.en} data-id={s.id_}>{s.en}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>



  <!-- ══ REVIEWS ═══════════════════════════════════════════════ -->
  <Reviews reviews={reviews} settings={settings} />

  <!-- ══ MENU ══════════════════════════════════════════════════ -->
  <Menu items={menuItems} />


  <!-- ══ LOCATION ══════════════════════════════════════════════ -->
  <section class="pc-section" id="location" aria-label="Location and hours">
    <div class="pc-container">
      <div class="loc__grid">
        <div class="loc__info">
          <p class="eyebrow reveal" data-en="Find Us" data-id="Temukan Kami">Find Us</p>
          <h2 class="loc__h2 reveal"
              data-en="Come Visit Us<br>on the Shore"
              data-id="Kunjungi Kami<br>di Tepi Pantai">
            Come Visit Us<br>on the Shore
          </h2>
          <div class="loc__contacts">
            {[
              { svg:`<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.4" fill="none"/>`, en:settings.address??'Jl. Pantai Biaung, Sanur, Denpasar, Bali 80228', id_:settings.address??'Jl. Pantai Biaung, Sanur, Denpasar, Bali 80228', lab:{en:'Address',id_:'Alamat'} },
              { svg:`<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 11a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.09-1.26a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z" stroke="currentColor" stroke-width="1.4" fill="none"/>`, en:settings.phone??'+62 819-1633-4989', id_:settings.phone??'+62 819-1633-4989', lab:{en:'Phone',id_:'Telepon'} },
              { svg:`<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.4" fill="none"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.4" fill="none"/>`, en:settings.email??'hello@putincoffee.com', id_:settings.email??'hello@putincoffee.com', lab:{en:'Email',id_:'Email'} },
            ].map((item, i) => (
              <div class="loc__contact-item reveal" style={`transition-delay:${80+i*60}ms`}>
                <div class="loc__contact-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={item.svg}/>
                </div>
                <div>
                  <p class="loc__contact-label" data-en={item.lab.en} data-id={item.lab.id_}>{item.lab.en}</p>
                  <p class="loc__contact-val" data-en={item.en} data-id={item.id_}>{item.en}</p>
                </div>
              </div>
            ))}
          </div>
          <div class="loc__hours reveal">
            <p class="loc__hours-head" data-en="Hours" data-id="Jam Buka">Hours</p>
            <div class="loc__hours-list">
              {(settings.hours ?? [
                { en:'Mon – Fri',             id_:'Sen – Jumat',              time:'6:00 AM – 12:00 PM', highlight:true  },
                { en:'Fri – Sun',             id_:'Jumat – Minggu',           time:'12:00 PM – 3:00 AM', highlight:true  },
                { en:'Kitchen closes',        id_:'Dapur tutup',              time:'9:30 PM',            highlight:false },
                { en:'Karaoke & Live Music SUN', id_:'Karaoke & Musik Live MIN', time:'7:00 PM – 9:00 PM', highlight:false },
              ]).map(h => (
                <div class={`loc__hours-row${h.highlight?' loc__hours-row--hi':''}`}>
                  <span data-en={h.en??h.label} data-id={h.id_??h.label}>{h.en??h.label}</span>
                  <span>{h.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="loc__map-card reveal-scale">
          <div class="loc__map-pin" aria-hidden="true">
            <svg width="52" height="52" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="#C9924A" stroke-width="1.4" fill="rgba(201,146,74,0.08)"/>
              <circle cx="12" cy="9" r="2.5" stroke="#C9924A" stroke-width="1.4" fill="none"/>
            </svg>
          </div>
          <h3 class="loc__map-name">put.in coffee</h3>
          <p class="loc__map-sub" data-en="Pantai Biaung, Sanur · Bali, Indonesia" data-id="Pantai Biaung, Sanur · Bali, Indonesia">Pantai Biaung, Sanur · Bali, Indonesia</p>
          <a
            href={settings.mapLink ?? 'https://www.google.com/maps/place/put.in+coffee+and+beer/data=!4m2!3m1!1s0x0:0x70829e134ab3dd00?sa=X&ved=1t:2428&ictx=111'}
            target="_blank" rel="noopener noreferrer"
            class="loc__map-btn" data-event="Maps Click"
            data-en="Open in Google Maps" data-id="Buka di Google Maps"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
            Open in Google Maps
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ RESERVATION ═══════════════════════════════════════════ -->
  <ReservationForm />

  <!-- ══ FOOTER ════════════════════════════════════════════════ -->
  <footer class="pc-footer" role="contentinfo">
    <div class="pc-container">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__logo">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3h8l1 5H7L8 3z" stroke="#C9924A" stroke-width="1.4" fill="none" stroke-linejoin="round"/><path d="M7 8c0 5 1.5 9 5 9s5-4 5-9" stroke="#C9924A" stroke-width="1.4" fill="none"/></svg>
            put.in coffee
          </div>
          <p class="footer__tagline" data-en="Where the ocean meets espresso. Beachfront specialty coffee on Pantai Biaung, Sanur, Bali." data-id="Di mana lautan bertemu espresso. Kopi spesial di tepi pantai Pantai Biaung, Sanur, Bali.">Where the ocean meets espresso. Beachfront specialty coffee on Pantai Biaung, Sanur, Bali.</p>
          <div class="footer__socials">
            {[
              { href:settings.instagramUrl??'#', label:'Instagram', svg:`<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>` },
              { href:`https://wa.me/${(settings.whatsapp??'+62 819-1633-4989').replace(/\s/g,'')}`, label:'WhatsApp', svg:`<path d="M21 12a9 9 0 01-9 9H5l-2 2V12a9 9 0 119 0z" stroke="currentColor" stroke-width="1.4" fill="none"/>` },
              { href:settings.tiktokUrl??'#', label:'TikTok', svg:`<path d="M9 12a4 4 0 104 4V4a5 5 0 005 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none"/>` },
            ].map(s => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="footer__social-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" set:html={s.svg}/>
              </a>
            ))}
          </div>
        </div>
        <nav class="footer__nav-col" aria-label="Explore">
          <h4 class="footer__col-head" data-en="Explore" data-id="Jelajahi">Explore</h4>
          <ul>{[['Our Story','#about','Kisah Kami'],['Menu','#menu','Menu'],['Experience','#experience','Pengalaman'],['Reviews','#reviews','Ulasan']].map(([en,href,id_]) => (<li><a href={href} class="footer__link" data-en={en} data-id={id_}>{en}</a></li>))}</ul>
        </nav>
        <nav class="footer__nav-col" aria-label="Visit">
          <h4 class="footer__col-head" data-en="Visit" data-id="Kunjungi">Visit</h4>
