{
  "name": "putincoffee",
  "version": "1.0.0",
  "private": true,
  "description": "Putin Coffee — Beachfront Café, Pantai Biaung, Sanur, Bali",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sanity": "cd sanity && sanity dev --port 3333",
