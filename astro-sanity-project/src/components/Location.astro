          data-en="come visit us<br>on the shore"
          data-id="kunjungi kami<br>di tepi pantai">
        come visit us<br>on the shore
      </h2>
    </header>

    <!-- Live status + clock -->
    <div class="loc__status glass-card" id="loc-status" data-reveal>
      <div class="loc__status-row">
        <div class="loc__status-left">
          <span class="loc__dot" id="loc-dot"></span>
          <span class="loc__status-txt" id="loc-txt"
