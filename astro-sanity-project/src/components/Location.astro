  </div><!-- /.loc__panel -->

  <!-- ═══ RIGHT: interactive Leaflet map ═════════════════ -->
  <div class="loc__map-wrap" data-reveal="scale">

    <!-- Map controls overlay -->
    <div class="loc__map-controls" aria-hidden="true">
      <button class="loc__zoom-btn" id="loc-zoom-in"  type="button" aria-label="Zoom in"  title="Zoom in">+</button>
      <button class="loc__zoom-btn" id="loc-zoom-out" type="button" aria-label="Zoom out" title="Zoom out">−</button>
    </div>

    <!-- Map container -->
    <div id="loc-map" class="loc__map"
         role="img" aria-label="put.in coffee interactive location map — Pantai Biaung, Denpasar, Bali"></div>

    <!-- Gradient border -->
