@media (max-width: 500px) {
  .res__form, .res__success { padding: 1.35rem; }
  .res__cards { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .res__reveal, .res__reveal-scale, .res__status-dot { transition: none !important; animation: none !important; }
}
</style>

<script>
(function () {

  /* ── Real-time WITA clock ──────────────────────────────── */
  var SCHEDULE = [
    { days:[1,2,3,4], open:6,  close:24 },
    { days:[5],       open:6,  close:27 },
    { days:[6,0],     open:12, close:27 },
  ];

  function isOpenNow(now) {
    var wita = new Date(now.getTime() + 8 * 3600000);
    var day  = wita.getUTCDay();
    var h    = wita.getUTCHours() + wita.getUTCMinutes() / 60;
    for (var i = 0; i < SCHEDULE.length; i++) {
      var s = SCHEDULE[i];
      if (s.days.indexOf(day) === -1) continue;
      if (h >= s.open && h < s.close) return true;
      if (s.close > 24 && h < (s.close - 24)) return true;
    }
    // previous day late window
    var prev = (day + 6) % 7;
    for (var j = 0; j < SCHEDULE.length; j++) {
      var ps = SCHEDULE[j];
      if (ps.days.indexOf(prev) === -1 || ps.close <= 24) continue;
      if (h < (ps.close - 24)) return true;
    }
    return false;
  }

  function updateClock() {
    var now  = new Date();
    var wita = new Date(now.getTime() + 8 * 3600000);
    var h    = wita.getUTCHours();
    var m    = wita.getUTCMinutes();
    var ampm = h >= 12 ? 'PM' : 'AM';
    var h12  = h % 12 || 12;
    var timeStr = h12 + ':' + (m < 10 ? '0' + m : m) + ' ' + ampm;
    var open = isOpenNow(now);
    var isID = document.documentElement.lang === 'id';

    var timeEl  = document.getElementById('res-time');
    var dotEl   = document.getElementById('res-dot');
    var statEl  = document.getElementById('res-status-text');
    var hoursEl = document.getElementById('res-hours-dynamic');

    if (timeEl) timeEl.textContent = timeStr;
    if (dotEl) dotEl.className = 'res__status-dot ' + (open ? 'open' : 'closed');
    if (statEl) {
      statEl.className = 'res__status-label ' + (open ? 'open' : 'closed');
      statEl.textContent = open
        ? (isID ? statEl.getAttribute('data-open-id') : statEl.getAttribute('data-open-en'))
        : (isID ? statEl.getAttribute('data-closed-id') : statEl.getAttribute('data-closed-en'));
    }
    if (hoursEl) {
      // Show today's hours inline
      var today = new Date(now.getTime() + 8 * 3600000).getUTCDay();
      var todayHours = '';
      if ([1,2,3,4].indexOf(today) !== -1) todayHours = isID ? '06.00 – 24.00 · setiap hari' : '6am – midnight · daily';
      else todayHours = isID ? '12.00 – 11.00 · akhir pekan' : '12am – 11pm · weekend';
      hoursEl.textContent = todayHours;
    }
  }

  /* ── Build Instagram DM URL from form ──────────────────── */
  function buildIgDmUrl() {
    var name    = (document.getElementById('r-name')?.value   || '').trim();
    var email   = (document.getElementById('r-email')?.value  || '').trim();
    var phone   = (document.getElementById('r-phone')?.value  || '').trim();
    var guests  = (document.getElementById('r-guests')?.value || '').trim();
    var date    = (document.getElementById('r-date')?.value   || '').trim();
    var time    = (document.getElementById('r-time')?.value   || '').trim();
    var msg     = (document.getElementById('r-msg')?.value    || '').trim();

    var lines = [
      'Hi put.in coffee!',
      '',
      'I\'d like to make a reservation:',
      '• Name: '    + (name    || '—'),
      '• Email: '   + (email   || '—'),
      '• Phone: '   + (phone   || '—'),
      '• Guests: '  + (guests  || '—'),
      '• Date: '    + (date    || '—'),
      '• Time: '    + (time    || '—'),
    ];
    if (msg) lines.push('• Notes: ' + msg);
    lines.push('', 'Looking forward to your reply! 🌊');
    return 'https://ig.me/m/put.in.coffee?text=' + encodeURIComponent(lines.join('\n'));
  }

  function validateForm() {
    var name  = (document.getElementById('r-name')?.value  || '').trim();
    var email = (document.getElementById('r-email')?.value || '').trim();
    var valid = true;
    var nameEl  = document.getElementById('r-name');
    var emailEl = document.getElementById('r-email');
    if (!name)  { nameEl?.classList.add('error');   valid = false; }
    else          nameEl?.classList.remove('error');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { emailEl?.classList.add('error');  valid = false; }
    else emailEl?.classList.remove('error');
    return valid;
  }

  function toast(type, title, msg) {
    window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type: type, title: title, message: msg } }));
  }

  /* ── Init ──────────────────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function () {

    /* Date min */
    var dateInput = document.getElementById('r-date');
    if (dateInput) {
      var n = new Date();
      var pad = function(v) { return String(v).padStart(2, '0'); };
      dateInput.min = n.getFullYear() + '-' + pad(n.getMonth() + 1) + '-' + pad(n.getDate());
    }

    /* Clock */
    updateClock();
    setInterval(updateClock, 30000);

    /* Reveal observer */
    var ro = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.res__reveal, .res__reveal-scale').forEach(function (el) { ro.observe(el); });

    /* Instagram DM button */
    var igBtn = document.getElementById('res-ig-btn');
    if (igBtn) {
      igBtn.addEventListener('click', function () {
        if (!validateForm()) {
          toast('error', 'missing info', 'please fill in your name and email first.');
          return;
        }
        var url = buildIgDmUrl();
        window.open(url, '_blank', 'noopener,noreferrer');
        if (window.plausible) window.plausible('Reservation IG DM');
      });
    }

    /* Netlify form submit (fallback) */
    var form = document.getElementById('res-form');
    var submitBtn = document.getElementById('res-submit');
    var success   = document.getElementById('res-success');

    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        if (!validateForm()) {
          toast('error', 'missing info', 'please fill in your name and email.');
          return;
        }
        if (submitBtn) { submitBtn.disabled = true; }
        var btnText = submitBtn?.querySelector('.res__btn-text');
        if (btnText) btnText.textContent = 'sending…';
        try {
          var res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form)).toString(),
          });
          if (res.ok) {
            form.hidden = true;
            if (success) success.hidden = false;
            if (window.plausible) window.plausible('Reservation Submit');
            toast('success', 'reservation received! 🎉', "we'll confirm within 2 hours.");
          } else throw new Error();
        } catch (_) {
          toast('error', 'something went wrong', 'try whatsapp or message us on instagram.');
          if (submitBtn) { submitBtn.disabled = false; }
          if (btnText) btnText.textContent = 'send reservation';
        }
      });
    }

    /* Share */
    var shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async function () {
        try {
          if (navigator.share) {
            await navigator.share({ title: 'put.in coffee · pantai biaung', text: 'beachfront coffee & good vibes ☕🌊', url: location.href });
          } else {
            await navigator.clipboard.writeText(location.href);
            toast('success', 'link copied!', 'share put.in coffee with your friends');
          }
        } catch (_) {}
      });
    }

    /* WhatsApp tracking */
    var waLink = document.getElementById('whatsapp-link');
    if (waLink) {
      waLink.addEventListener('click', function () {
        if (window.plausible) window.plausible('WhatsApp Click');
      });
    }

    /* Language */
    document.addEventListener('pc:lang', function (e) {
      var isID = e.detail && e.detail.isID;
      document.querySelectorAll('[data-en][data-id]').forEach(function (el) {
        if (el.tagName === 'SELECT' || el.tagName === 'OPTION' || el.children.length > 0) return;
        var val = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
        if (val !== null) el.textContent = val;
      });
      document.querySelectorAll('option[data-en]').forEach(function (o) {
        var val = isID ? o.getAttribute('data-id') : o.getAttribute('data-en');
        if (val) o.textContent = val;
      });
      updateClock();
    });

  });
})();
</script>