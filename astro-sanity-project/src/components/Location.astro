---
// src/components/Location.astro  ·  put.in coffee  ·  v2
// Instagram + WhatsApp + TikTok · Leaflet interactive map · WITA live clock · EN/ID
// GPS: -8.7344, 115.2529 — Pantai Biaung, Denpasar, Bali
---

<!-- Leaflet CSS — lazy loaded -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" media="print" onload="this.media='all'"/>

<section class="loc pc-section" id="location" aria-label="Find us — come visit put.in coffee">
<div class="pc-container">
<div class="loc__layout">

  <!-- ═══ LEFT: info panel ════════════════════════════════ -->
