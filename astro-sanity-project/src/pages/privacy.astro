---
// src/pages/privacy.astro  ·  put.in coffee  ·  Privacy Policy
import LegalLayout from '../layouts/LegalLayout.astro';
---

<LegalLayout
  title="Privacy Policy"
  titleId="Kebijakan Privasi"
  description="How put.in coffee collects, uses and protects your personal information."
  lastUpdated="June 2026"
  section="privacy"
>

<div class="ls">

  <!-- Intro -->
  <div class="ls__intro">
    <p data-en="At put.in coffee, your privacy is as sacred as the view from Pantai Biaung. This policy explains — plainly and honestly — what we collect, why, and how we keep it safe."
       data-id="Di put.in coffee, privasi Anda sama sakralnya dengan pemandangan dari Pantai Biaung. Kebijakan ini menjelaskan — dengan jelas dan jujur — apa yang kami kumpulkan, mengapa, dan bagaimana kami menjaganya.">
      At put.in coffee, your privacy is as sacred as the view from Pantai Biaung. This policy explains — plainly and honestly — what we collect, why, and how we keep it safe.
    </p>
  </div>

  <!-- 01 Who we are -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
          <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">01</span>
        <h2 class="ls__block-title" data-en="who we are" data-id="siapa kami">who we are</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="put.in coffee is a beachfront café at Jl. Pantai Biaung, Sanur, Denpasar, Bali 80228, Indonesia. We are the sole data controller for all personal information shared through this website, our reservation form, or our social media channels."
         data-id="put.in coffee adalah kafe tepi pantai di Jl. Pantai Biaung, Sanur, Denpasar, Bali 80228, Indonesia. Kami adalah pengontrol data tunggal untuk semua informasi pribadi yang dibagikan melalui situs ini, formulir reservasi, atau saluran media sosial kami.">
        put.in coffee is a beachfront café at Jl. Pantai Biaung, Sanur, Denpasar, Bali 80228, Indonesia. We are the sole data controller for all personal information shared through this website, our reservation form, or our social media channels.
      </p>
      <a href="https://www.instagram.com/put.in.coffee/" class="ls__contact-pill" target="_blank" rel="noopener">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.7" fill="none"/>
          <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.7" fill="none"/>
          <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
        </svg>
        @put.in.coffee
      </a>
    </div>
  </div>

  <!-- 02 What we collect -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <line x1="9" y1="13" x2="15" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="9" y1="17" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">02</span>
        <h2 class="ls__block-title" data-en="what we collect" data-id="apa yang kami kumpulkan">what we collect</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="We collect only what is necessary to serve you well:"
         data-id="Kami hanya mengumpulkan yang diperlukan untuk melayani Anda dengan baik:">
        We collect only what is necessary to serve you well:
      </p>
      <ul>
        <li data-en="Reservation details — name, email, phone number, date, time, guest count, and any special requests submitted via our contact form."
            data-id="Detail reservasi — nama, email, nomor telepon, tanggal, waktu, jumlah tamu, dan permintaan khusus yang dikirim melalui formulir kontak kami.">
          Reservation details — name, email, phone number, date, time, guest count, and any special requests submitted via our contact form.
        </li>
        <li data-en="Analytics data — anonymised page views and session duration via Plausible Analytics (no cookies, no fingerprinting, GDPR-compliant)."
            data-id="Data analitik — tampilan halaman anonim dan durasi sesi melalui Plausible Analytics (tanpa cookie, tanpa sidik jari, sesuai GDPR).">
          Analytics data — anonymised page views and session duration via Plausible Analytics (no cookies, no fingerprinting, GDPR-compliant).
        </li>
        <li data-en="Instagram DM content — when you contact us via Instagram, that conversation is governed by Instagram's own privacy policy."
            data-id="Konten Instagram DM — saat Anda menghubungi kami melalui Instagram, percakapan tersebut diatur oleh kebijakan privasi Instagram sendiri.">
          Instagram DM content — when you contact us via Instagram, that conversation is governed by Instagram's own privacy policy.
        </li>
      </ul>
      <p style="margin-top:.75rem"
         data-en="We do not collect payment information. We do not set tracking cookies. We do not sell your data. Ever."
         data-id="Kami tidak mengumpulkan informasi pembayaran. Kami tidak memasang cookie pelacak. Kami tidak menjual data Anda. Selamanya.">
        <strong>We do not collect payment information. We do not set tracking cookies. We do not sell your data. Ever.</strong>
      </p>
    </div>
  </div>

  <!-- 03 How we use it -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">03</span>
        <h2 class="ls__block-title" data-en="how we use your information" data-id="bagaimana kami menggunakan informasi anda">how we use your information</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="Your information is used exclusively to:"
         data-id="Informasi Anda digunakan secara eksklusif untuk:">
        Your information is used exclusively to:
      </p>
      <ul>
        <li data-en="Confirm and manage your table reservation."
            data-id="Mengkonfirmasi dan mengelola reservasi meja Anda.">Confirm and manage your table reservation.</li>
        <li data-en="Respond to enquiries about private events, catering, or general questions."
            data-id="Merespons pertanyaan tentang acara privat, katering, atau pertanyaan umum.">Respond to enquiries about private events, catering, or general questions.</li>
        <li data-en="Improve our website experience through aggregate, anonymised analytics."
            data-id="Meningkatkan pengalaman situs kami melalui analitik agregat dan anonim.">Improve our website experience through aggregate, anonymised analytics.</li>
      </ul>
      <p style="margin-top:.7rem"
         data-en="We will never use your contact details for unsolicited marketing without your explicit consent."
         data-id="Kami tidak akan pernah menggunakan detail kontak Anda untuk pemasaran tanpa izin tanpa persetujuan eksplisit Anda.">
        We will never use your contact details for unsolicited marketing without your explicit consent.
      </p>
    </div>
  </div>

  <!-- 04 Data retention -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M3 6h18M8 6V4h8v2M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <line x1="10" y1="11" x2="10" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="14" y1="11" x2="14" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">04</span>
        <h2 class="ls__block-title" data-en="how long we keep your data" data-id="berapa lama kami menyimpan data anda">how long we keep your data</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="Reservation submissions are stored by Netlify Forms for 30 days, then permanently deleted. We do not maintain a separate customer database. Anonymised analytics data is retained for 12 months."
         data-id="Pengiriman reservasi disimpan oleh Netlify Forms selama 30 hari, lalu dihapus secara permanen. Kami tidak memiliki basis data pelanggan terpisah. Data analitik anonim disimpan selama 12 bulan.">
        Reservation submissions are stored by Netlify Forms for 30 days, then permanently deleted. We do not maintain a separate customer database. Anonymised analytics data is retained for 12 months.
      </p>
    </div>
  </div>

  <!-- 05 Third-party services -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="5"  r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <circle cx="19" cy="19" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <circle cx="5"  cy="19" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <line x1="12" y1="8"  x2="5"  y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="12" y1="8"  x2="19" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">05</span>
        <h2 class="ls__block-title" data-en="third-party services" data-id="layanan pihak ketiga">third-party services</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="Our site uses the following external services, each with their own privacy policy:"
         data-id="Situs kami menggunakan layanan eksternal berikut, masing-masing dengan kebijakan privasi mereka sendiri:">
        Our site uses the following external services, each with their own privacy policy:
      </p>
      <ul>
        <li><strong>Netlify</strong> — <span data-en="hosting and form processing" data-id="hosting dan pemrosesan formulir">hosting and form processing</span></li>
        <li><strong>Plausible Analytics</strong> — <span data-en="privacy-first, cookieless analytics" data-id="analitik tanpa cookie">privacy-first, cookieless analytics</span></li>
        <li><strong>OpenStreetMap / CARTO</strong> — <span data-en="map tiles for our location section (no personal data transmitted)" data-id="tile peta untuk bagian lokasi kami (tidak ada data pribadi yang dikirim)">map tiles for our location section (no personal data transmitted)</span></li>
        <li><strong>Instagram / Meta</strong> — <span data-en="social media and DM reservations, governed by Meta's privacy policy" data-id="media sosial dan reservasi DM, diatur oleh kebijakan privasi Meta">social media and DM reservations, governed by Meta's privacy policy</span></li>
        <li><strong>Google Maps</strong> — <span data-en="external link for directions only — no embed" data-id="tautan eksternal untuk petunjuk arah saja — tanpa embed">external link for directions only — no embed</span></li>
      </ul>
    </div>
  </div>

  <!-- 06 Your rights -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">06</span>
        <h2 class="ls__block-title" data-en="your rights" data-id="hak-hak anda">your rights</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="You have the right to access, correct, or request deletion of any personal data we hold about you. To exercise any of these rights, contact us directly:"
         data-id="Anda memiliki hak untuk mengakses, mengoreksi, atau meminta penghapusan data pribadi yang kami miliki. Untuk menggunakan hak-hak ini, hubungi kami langsung:">
        You have the right to access, correct, or request deletion of any personal data we hold about you. To exercise any of these rights, contact us directly:
      </p>
      <div style="display:flex;gap:.55rem;flex-wrap:wrap;margin-top:.65rem">
        <a href="https://wa.me/6281916334989" class="ls__contact-pill" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M21 12a9 9 0 01-9 9H5l-2 2V12a9 9 0 119 0z" stroke="currentColor" stroke-width="1.7" fill="none"/>
          </svg>
          <span data-en="WhatsApp us" data-id="WhatsApp kami">WhatsApp us</span>
        </a>
        <a href="https://www.instagram.com/put.in.coffee/" class="ls__contact-pill" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.7" fill="none"/>
            <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.7" fill="none"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
          </svg>
          @put.in.coffee
        </a>
      </div>
    </div>
  </div>

  <!-- 07 Changes -->
  <div class="ls__block">
    <div class="ls__block-head">
      <div class="ls__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </div>
      <div>
        <span class="ls__num">07</span>
        <h2 class="ls__block-title" data-en="changes to this policy" data-id="perubahan kebijakan ini">changes to this policy</h2>
      </div>
    </div>
    <div class="ls__block-body">
      <p data-en="We may update this policy occasionally to reflect changes in law or our practices. The 'last updated' date at the top of this page will always reflect the most recent revision. Continued use of our website after any change constitutes acceptance of the updated policy."
         data-id="Kami dapat memperbarui kebijakan ini sesekali untuk mencerminkan perubahan hukum atau praktik kami. Tanggal 'terakhir diperbarui' selalu mencerminkan revisi terbaru. Penggunaan situs yang berkelanjutan setelah perubahan merupakan penerimaan kebijakan yang diperbarui.">
        We may update this policy occasionally to reflect changes in law or our practices. The 'last updated' date at the top of this page will always reflect the most recent revision. Continued use of our website after any change constitutes acceptance of the updated policy.
      </p>
    </div>
  </div>

</div>

</LegalLayout>