---

<!-- ══ MENU ════════════════════════════════════════════════════ -->
<section class="menu" id="menu" aria-label="our menu">
  <div class="menu__wrap">

    <!-- Header -->
    <header class="menu__head reveal">
      <p class="eyebrow" data-en="what we brew" data-id="apa yang kami sajikan">what we brew</p>
      <h2 data-en="the put.in menu" data-id="menu put.in">the put.in menu</h2>
      <p class="menu__sub"
         data-en="bali highland beans, honest food, ocean breeze — served daily from 7am."
         data-id="biji kopi pegunungan bali, makanan jujur, angin laut — disajikan setiap hari mulai jam 7.">
        bali highland beans, honest food, ocean breeze — served daily from 7am.
      </p>
    </header>

    <!-- Category tabs — styled as a restaurant menu divider -->
    <nav class="menu__tabs" role="tablist" aria-label="menu categories">
      {tabs.map((t, i) => (
        <button
          class="menu__tab"
          data-cat={t.id}
          data-color={t.color}
          data-en={t.en}
          data-id={t.id_}
          data-sub-en={t.sub.en}
          data-sub-id={t.sub.id_}
          role="tab"
          aria-selected="false"
          type="button"
        >
          <span class="menu__tab-name">{t.en}</span>
          <span class="menu__tab-sub">{t.sub.en}</span>
        </button>
      ))}
    </nav>

    <!-- Category sections -->
    {tabs.map((t, ti) => (
      <div
        class={`menu__section${ti === 0 ? '' : ' menu__section--hidden'}`}
        data-section={t.id}
        role="tabpanel"
        style={`--cat-color:${t.color}`}
      >
        <!-- Section header -->
        <div class="menu__section-head">
          <div class="menu__section-rule"></div>
          <span class="menu__section-title" data-en={t.en} data-id={t.id_}>{t.en}</span>
          <span class="menu__section-subtitle" data-en={t.sub.en} data-id={t.sub.id_}>{t.sub.en}</span>
          <div class="menu__section-rule"></div>
        </div>

        <!-- Items grid: restaurant list style -->
        <div class="menu__list">
          {items.filter(item => item.category === t.id).map((item) => (
            <button
              class="menu__item"
              data-id={item.id}
              type="button"
              aria-label={`view ${item.name} — ${item.price}`}
            >
              <!-- Left: icon + name -->
              <div class="menu__item-left">
                <div class="menu__item-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={icons[item.icon] ?? icons['espresso']}/>
                </div>
                <div class="menu__item-info">
                  <span class="menu__item-name" data-en={item.name} data-id={item.nameId}>{item.name}</span>
                  {item.desc && (
                    <span class="menu__item-desc" data-en={item.desc} data-id={item.descId ?? item.desc}>{item.desc}</span>
                  )}
                  <div class="menu__item-badges">
                    {item.tag && (
                      <span class={`menu__badge menu__badge--${item.tag}`}>
                        {item.tag === 'bestseller' ? 'best seller' : item.tag === 'new' ? 'new' : 'signature'}
                      </span>
                    )}
                    {item.size && (
                      <span class="menu__badge menu__badge--size">{item.size}</span>
                    )}
                  </div>
                </div>
              </div>
              <!-- Dotted rule -->
              <span class="menu__item-dots" aria-hidden="true"></span>
              <!-- Right: price + zoom cue -->
              <div class="menu__item-right">
                <span class="menu__item-price">{item.price}</span>
                <span class="menu__item-zoom" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M9.5 9.5l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M4 6h4M6 4v4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                  </svg>
                </span>
              </div>
            </button>
          ))}
        </div>
      </div>
    ))}

  </div>
</section>

<!-- ══ MODAL / DETAIL ═════════════════════════════════════════ -->
<div class="mmodal" id="menu-modal" aria-modal="true" role="dialog" aria-label="item detail" style="display:none">
  <div class="mmodal__backdrop"></div>
  <div class="mmodal__panel">

    <!-- Close -->
    <button class="mmodal__close" type="button" aria-label="close">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Ambient glow -->
    <div class="mmodal__ambient" id="modal-ambient" aria-hidden="true"></div>

    <!-- Icon stage -->
    <div class="mmodal__icon-stage">
      <div class="mmodal__icon-ring" aria-hidden="true"></div>
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" id="modal-icon" class="mmodal__icon"></svg>
    </div>

    <!-- Content -->
    <div class="mmodal__content">
      <div class="mmodal__meta">
        <span class="mmodal__tag" id="modal-tag" style="display:none"></span>
        <span class="mmodal__size" id="modal-size" style="display:none"></span>
      </div>
      <h2 class="mmodal__name" id="modal-name"></h2>
      <p class="mmodal__desc" id="modal-desc"></p>

      <!-- Price row -->
      <div class="mmodal__footer">
        <div class="mmodal__price-block">
          <span class="mmodal__price-label" data-en="price" data-id="harga">price</span>
          <span class="mmodal__price" id="modal-price"></span>
        </div>
        <a href="#contact" class="mmodal__cta" id="modal-cta"
           data-en="reserve a table" data-id="pesan meja">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 18V5l12-2v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
          reserve a table
        </a>
      </div>
    </div>

  </div>
</div>

<!-- Item data -->
<script type="application/json" id="menu-data" set:html={JSON.stringify(items)}></script>

<style>
/* ── Reset ──────────────────────────────────────────────────── */
.menu__item, .menu__tab {
  appearance: none; background: none; border: none;
  text-align: left; cursor: pointer; padding: 0;
  font-family: inherit;
}

/* ── Section ────────────────────────────────────────────────── */
.menu { padding: var(--section-py, 5rem) 0; }
.menu__wrap { max-width: var(--content-width, 1100px); margin: 0 auto; padding: 0 var(--container-px, 1.5rem); }

/* ── Header ─────────────────────────────────────────────────── */
.menu__head { text-align: center; margin-bottom: 3rem; }
.menu__head h2 { text-transform: lowercase; margin: .5rem 0; font-size: clamp(1.7rem, 3.5vw, 2.5rem); color: var(--cream, #F0E8DC); }
.eyebrow { font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--gold, #C9924A); display: block; }
.menu__sub { font-size: .875rem; font-weight: 300; color: var(--muted, rgba(240,232,220,.45)); max-width: 400px; margin: .5rem auto 0; text-transform: lowercase; line-height: 1.65; }

/* ── Category tabs ──────────────────────────────────────────── */
.menu__tabs {
  display: flex; flex-wrap: wrap; gap: .4rem;
  justify-content: center;
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border, rgba(240,232,220,.08));
}
.menu__tab {
  display: flex; flex-direction: column; align-items: center;
  padding: .65rem 1.1rem;
  border-radius: 12px;
  border: 1px solid var(--border, rgba(240,232,220,.08));
  background: var(--glass, rgba(240,232,220,.03));
  transition: border-color .2s, background .2s, box-shadow .2s, transform .15s;
  min-width: 90px; gap: 2px;
}
.menu__tab:hover { transform: translateY(-1px); }
.menu__tab:active { transform: scale(.97); }
.menu__tab-name {
  font-size: .75rem; font-weight: 500; color: var(--muted, rgba(240,232,220,.45));
  text-transform: lowercase; letter-spacing: .02em; transition: color .2s;
  white-space: nowrap;
}
.menu__tab-sub {
  font-size: .58rem; font-weight: 300; color: rgba(240,232,220,.2);
  text-transform: lowercase; letter-spacing: .03em; transition: color .2s;
  white-space: nowrap;
}
.menu__tab--on {
  border-color: var(--tab-color, rgba(201,146,74,.45));
  background: var(--tab-bg, rgba(201,146,74,.08));
  box-shadow: 0 2px 18px var(--tab-shadow, rgba(201,146,74,.15));
}
.menu__tab--on .menu__tab-name { color: var(--tab-color, #C9924A); font-weight: 600; }
.menu__tab--on .menu__tab-sub  { color: var(--tab-color, rgba(201,146,74,.6)); opacity: .7; }

/* ── Section panel ──────────────────────────────────────────── */
.menu__section--hidden { display: none; }
.menu__section { animation: section-in .38s ease both; }
@keyframes section-in { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }

/* Section header — restaurant divider */
.menu__section-head {
  display: flex; align-items: center; gap: 1rem;
  margin-bottom: 2rem;
}
.menu__section-rule {
  flex: 1; height: 1px;
  background: linear-gradient(to right, transparent, var(--cat-color, #C9924A), transparent);
  opacity: .3;
}
.menu__section-title {
  font-family: var(--font-display, serif);
  font-size: 1.1rem; font-style: italic; font-weight: 400;
  color: var(--cat-color, #C9924A); white-space: nowrap;
}
.menu__section-subtitle {
  font-size: .62rem; font-weight: 300; letter-spacing: .1em;
  color: var(--muted, rgba(240,232,220,.4)); white-space: nowrap; text-transform: lowercase;
}

/* ── Items list ─────────────────────────────────────────────── */
.menu__list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
@media (max-width: 700px) { .menu__list { grid-template-columns: 1fr; } }

/* ── Single item row ────────────────────────────────────────── */
.menu__item {
  display: flex; align-items: center; gap: .75rem;
  padding: .95rem 1rem;
  border-bottom: 1px solid rgba(240,232,220,.05);
  border-radius: 0;
  transition: background .18s, transform .18s;
  position: relative; width: 100%;
}
/* Alternate rows: left column gets right border */
.menu__list > .menu__item:nth-child(odd) {
  border-right: 1px solid rgba(240,232,220,.05);
}
@media (max-width: 700px) {
  .menu__list > .menu__item:nth-child(odd) { border-right: none; }
}
.menu__item:hover {
  background: rgba(255,255,255,.025);
  transform: scale(1.012);
  z-index: 1;
  border-radius: 10px;
}
.menu__item:active { transform: scale(.985); }
.menu__item:focus-visible { outline: 2px solid var(--cat-color, #C9924A); outline-offset: 2px; border-radius: 8px; }

/* Icon */
.menu__item-icon {
  width: 38px; height: 38px; flex-shrink: 0;
  border-radius: 10px;
  background: rgba(255,255,255,.03);
  border: 1px solid rgba(255,255,255,.06);
  display: flex; align-items: center; justify-content: center;
  color: var(--cat-color, #C9924A);
  transition: background .18s;
}
.menu__item:hover .menu__item-icon {
  background: rgba(var(--cat-color-rgb, 201,146,74), .1);
}

/* Info */
.menu__item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.menu__item-name {
  font-size: .83rem; font-weight: 500;
  color: var(--cream, #F0E8DC); text-transform: lowercase; line-height: 1.3;
  /* truncate on small screens */
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.menu__item:hover .menu__item-name { white-space: normal; }
.menu__item-desc {
  font-size: .68rem; font-weight: 300; color: var(--muted, rgba(240,232,220,.4));
  text-transform: lowercase; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.menu__item:hover .menu__item-desc { white-space: normal; }

/* Badges */
.menu__item-badges { display: flex; gap: .3rem; flex-wrap: wrap; margin-top: 2px; }
.menu__badge {
  font-size: .52rem; font-weight: 700; letter-spacing: .06em; text-transform: lowercase;
  padding: 1px 6px; border-radius: 50px;
}
.menu__badge--bestseller { background: linear-gradient(135deg, #E07A5F, #C9924A); color: #0a0a0a; }
.menu__badge--new        { background: linear-gradient(135deg, #5bdb83, #38bdf8); color: #0a0a0a; }
.menu__badge--signature  { background: linear-gradient(135deg, #f4d07a, #C9924A); color: #0a0a0a; }
.menu__badge--size       { background: rgba(201,146,74,.12); border: 1px solid rgba(201,146,74,.2); color: rgba(232,199,122,.7); }

/* Dotted rule — the luxury element */
.menu__item-dots {
  flex: 1; min-width: 12px;
  border-bottom: 1px dashed rgba(240,232,220,.1);
  margin: 0 .4rem; align-self: flex-end;
  margin-bottom: 8px;
}

/* Price + zoom */
.menu__item-right {
  display: flex; align-items: center; gap: .5rem; flex-shrink: 0;
}
.menu__item-price {
  font-family: var(--font-display, serif); font-style: italic;
  font-size: .95rem; font-weight: 500;
  color: var(--cat-color, #C9924A); white-space: nowrap;
}
.menu__item-zoom {
  color: rgba(240,232,220,.18);
  transition: color .18s;
  display: flex; align-items: center;
}
.menu__item:hover .menu__item-zoom { color: var(--cat-color, rgba(201,146,74,.6)); }

/* ═══════════════════════════════════════════════════════════
   MODAL
═══════════════════════════════════════════════════════════ */
.mmodal {
  position: fixed; inset: 0; z-index: 300;
  display: flex; align-items: center; justify-content: center;
  padding: 1rem;
}
.mmodal__backdrop {
  position: absolute; inset: 0;
  background: rgba(5,4,3,.82);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  cursor: pointer;
}
.mmodal__panel {
  position: relative; z-index: 1;
  width: 100%; max-width: 420px;
  background: #171410;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 24px;
  overflow: hidden;
  padding: 0 2rem 2rem;
  animation: modal-in .38s cubic-bezier(.22,1,.36,1) both;
}
@keyframes modal-in {
  from { transform: scale(.92) translateY(16px); opacity: 0; }
  to   { transform: scale(1)   translateY(0);    opacity: 1; }
}
.mmodal--closing .mmodal__panel {
  animation: modal-out .22s ease-in forwards;
}
@keyframes modal-out {
  from { transform: scale(1)   translateY(0);    opacity: 1; }
  to   { transform: scale(.92) translateY(16px); opacity: 0; }
}

/* Ambient radial glow behind icon */
.mmodal__ambient {
  position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
  width: 280px; height: 280px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--modal-color, rgba(201,146,74,.18)) 0%, transparent 70%);
  pointer-events: none; z-index: 0;
  transition: background .35s;
}

/* Close */
.mmodal__close {
  position: absolute; top: 1.1rem; right: 1.25rem;
  width: 32px; height: 32px; border-radius: 50%;
  background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1);
  color: rgba(240,232,220,.45); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s, color .2s; z-index: 2;
  appearance: none;
}
.mmodal__close:hover { background: rgba(255,255,255,.1); color: var(--cream, #F0E8DC); }

/* Icon stage */
.mmodal__icon-stage {
  position: relative; display: flex; align-items: center; justify-content: center;
  height: 120px; margin: 1rem 0 0; z-index: 1;
}
.mmodal__icon-ring {
  position: absolute;
  width: 96px; height: 96px;
  border-radius: 50%;
  border: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.025);
}
.mmodal__icon {
  position: relative; z-index: 1;
  color: var(--modal-color, #E8C97A);
  filter: drop-shadow(0 6px 20px var(--modal-shadow, rgba(201,146,74,.45)));
  transition: color .3s;
}

/* Content */
.mmodal__content { position: relative; z-index: 1; padding-top: .75rem; }
.mmodal__meta { display: flex; align-items: center; gap: .5rem; margin-bottom: .6rem; }
.mmodal__tag {
  font-size: .58rem; font-weight: 700; letter-spacing: .06em; text-transform: lowercase;
  padding: 2px 8px; border-radius: 50px;
}
.mmodal__tag--bestseller { background: linear-gradient(135deg, #E07A5F, #C9924A); color: #0a0a0a; }
.mmodal__tag--new        { background: linear-gradient(135deg, #5bdb83, #38bdf8); color: #0a0a0a; }
.mmodal__tag--signature  { background: linear-gradient(135deg, #f4d07a, #C9924A); color: #0a0a0a; }
.mmodal__size {
  font-size: .62rem; color: var(--muted); border: 1px solid rgba(255,255,255,.1);
  border-radius: 50px; padding: 2px 8px; text-transform: lowercase;
}

.mmodal__name {
  font-family: var(--font-display, serif);
  font-size: clamp(1.3rem, 4vw, 1.65rem); font-weight: 400; font-style: italic;
  color: var(--cream, #F0E8DC); text-transform: lowercase; margin: 0 0 .7rem; line-height: 1.2;
}
.mmodal__desc {
  font-size: .85rem; font-weight: 300; color: var(--muted, rgba(240,232,220,.5));
  line-height: 1.7; margin: 0 0 1.5rem; text-transform: lowercase;
}

/* Footer */
.mmodal__footer {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(240,232,220,.07);
}
.mmodal__price-block { display: flex; flex-direction: column; gap: 2px; }
.mmodal__price-label { font-size: .6rem; font-weight: 400; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.mmodal__price {
  font-family: var(--font-display, serif); font-style: italic;
  font-size: 1.65rem; font-weight: 400;
  color: var(--modal-color, #E8C97A); line-height: 1; transition: color .3s;
}
.mmodal__cta {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .65rem 1.25rem; border-radius: 50px;
  background: var(--modal-color, #C9924A);
  /* darken text on colored bg */
  color: #0a0800;
  font-family: var(--font-body, sans-serif);
  font-size: .78rem; font-weight: 600; text-decoration: none; text-transform: lowercase;
  transition: opacity .2s, box-shadow .2s;
  white-space: nowrap;
}
.mmodal__cta:hover { opacity: .88; box-shadow: 0 4px 16px var(--modal-shadow, rgba(201,146,74,.35)); }

/* Responsive modal on very small screens */
@media (max-width: 480px) {
  .mmodal__panel { max-width: 100%; border-radius: 20px 20px 0 0; }
  .mmodal { align-items: flex-end; padding: 0; }
  .mmodal__icon-stage { height: 100px; }
}

/* ── Reveal ─────────────────────────────────────────────────── */
.reveal { opacity:0; transform:translateY(18px); transition:opacity .55s ease,transform .55s ease; }
.reveal.in { opacity:1; transform:none; }

/* ── Reduced motion ─────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .menu__item, .menu__tab, .mmodal__panel { transition:none!important; animation:none!important; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Data ───────────────────────────────────────────────── */
  var raw   = (document.getElementById('menu-data') || {}).textContent || '[]';
  var items = JSON.parse(raw);

  var catColors = {
    'coffee':     '#C9924A',
    'signature':  '#E8A87C',
    'non-coffee': '#7FB069',
    'food':       '#E07A5F',
    'snack':      '#F2CC8F',
    'beer':       '#F4A261',
  };

  /* ── Helpers ────────────────────────────────────────────── */
  function hexToRgba(hex, a) {
    var r = parseInt(hex.slice(1,3),16);
    var g = parseInt(hex.slice(3,5),16);
    var b = parseInt(hex.slice(5,7),16);
    return 'rgba('+r+','+g+','+b+','+a+')';
  }

  /* ── Category tabs ──────────────────────────────────────── */
  var tabs     = document.querySelectorAll('.menu__tab');
  var sections = document.querySelectorAll('.menu__section');

  function activateTab(tab) {
    var cat   = tab.getAttribute('data-cat');
    var color = catColors[cat] || '#C9924A';
    var bg    = hexToRgba(color, 0.09);
    var shadow= hexToRgba(color, 0.16);

    tabs.forEach(function(t) {
      t.classList.remove('menu__tab--on');
      t.setAttribute('aria-selected','false');
      t.style.removeProperty('--tab-color');
      t.style.removeProperty('--tab-bg');
      t.style.removeProperty('--tab-shadow');
    });
    tab.classList.add('menu__tab--on');
    tab.setAttribute('aria-selected','true');
    tab.style.setProperty('--tab-color', color);
    tab.style.setProperty('--tab-bg', bg);
    tab.style.setProperty('--tab-shadow', shadow);

    sections.forEach(function(s) {
      if (s.getAttribute('data-section') === cat) {
        s.classList.remove('menu__section--hidden');
        // retrigger animation
        s.style.animation = 'none';
        void s.offsetHeight;
        s.style.animation = '';
      } else {
        s.classList.add('menu__section--hidden');
      }
    });
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() { activateTab(tab); });
  });
  if (tabs[0]) activateTab(tabs[0]);

  /* ── Modal ──────────────────────────────────────────────── */
  var modal     = document.getElementById('menu-modal');
  var backdrop  = modal.querySelector('.mmodal__backdrop');
  var closeBtn  = modal.querySelector('.mmodal__close');
  var ambient   = document.getElementById('modal-ambient');
  var isOpen    = false;
  var currentItem = null;

  function openModal(item) {
    currentItem = item;
    var color   = catColors[item.category] || '#C9924A';
    var shadow  = hexToRgba(color, 0.45);
    var glow    = hexToRgba(color, 0.18);
    var isID    = document.documentElement.lang === 'id';

    /* icon — clone SVG paths from the list item */
    var srcIcon   = document.querySelector('.menu__item[data-id="' + item.id + '"] .menu__item-icon svg');
    var modalIcon = document.getElementById('modal-icon');
    if (srcIcon && modalIcon) { modalIcon.innerHTML = srcIcon.innerHTML; }

    /* ambient + color vars */
    if (ambient) ambient.style.background = 'radial-gradient(circle, ' + glow + ' 0%, transparent 70%)';
    var panel = modal.querySelector('.mmodal__panel');
    panel.style.setProperty('--modal-color', color);
    panel.style.setProperty('--modal-shadow', shadow);
    document.getElementById('modal-icon').style.color = color;
    document.getElementById('modal-price').style.color = color;

    /* tag */
    var tagEl = document.getElementById('modal-tag');
    if (item.tag) {
      tagEl.style.display = '';
      tagEl.className = 'mmodal__tag mmodal__tag--' + item.tag;
      tagEl.textContent = item.tag === 'bestseller' ? 'best seller' : item.tag === 'new' ? 'new' : 'signature';
    } else {
      tagEl.style.display = 'none';
    }

    /* size */
    var sizeEl = document.getElementById('modal-size');
    if (item.size) { sizeEl.style.display = ''; sizeEl.textContent = item.size; }
    else             sizeEl.style.display = 'none';

    /* texts */
    document.getElementById('modal-name').textContent  = isID ? item.nameId : item.name;
    document.getElementById('modal-desc').textContent  = (isID ? item.descId : item.desc) || '';
    document.getElementById('modal-price').textContent = item.price;

    /* CTA color */
    var ctaEl = document.getElementById('modal-cta');
    if (ctaEl) {
      ctaEl.style.background = color;
      // pick text color based on lightness (simple heuristic)
      var r = parseInt(color.slice(1,3),16);
      var g = parseInt(color.slice(3,5),16);
      var b = parseInt(color.slice(5,7),16);
      var luma = (0.299*r + 0.587*g + 0.114*b) / 255;
      ctaEl.style.color = luma > 0.6 ? '#0a0800' : '#ffffff';
    }

    modal.style.display = 'flex';
    modal.classList.remove('mmodal--closing');
    panel.style.animation = 'none';
    void panel.offsetHeight;
    panel.style.animation = '';
    document.body.style.overflow = 'hidden';
    isOpen = true;
    setTimeout(function() { closeBtn.focus(); }, 60);
  }

  function closeModal() {
    if (!isOpen) return;
    modal.classList.add('mmodal--closing');
    var panel = modal.querySelector('.mmodal__panel');
    function onEnd() {
      modal.style.display = 'none';
      modal.classList.remove('mmodal--closing');
      document.body.style.overflow = '';
      isOpen = false;
      panel.removeEventListener('animationend', onEnd);
    }
    panel.addEventListener('animationend', onEnd);
  }

  /* Item click */
  document.querySelectorAll('.menu__item').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id   = btn.getAttribute('data-id');
      var item = items.find(function(i) { return i.id === id; });
      if (item) openModal(item);
    });
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && isOpen) closeModal();
  });

  /* ── Language ───────────────────────────────────────────── */
  document.addEventListener('pc:lang', function(e) {
    var isID = e.detail && e.detail.isID;

    // All simple text nodes
    document.querySelectorAll('[data-en][data-id]').forEach(function(el) {
      if (el.children.length > 0) return;
      var val = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (val !== null) el.textContent = val;
    });

    // Tab sub-labels
    tabs.forEach(function(tab) {
      var name = isID ? tab.getAttribute('data-id') : tab.getAttribute('data-en');
      var sub  = isID ? tab.getAttribute('data-sub-id') : tab.getAttribute('data-sub-en');
      var nameEl = tab.querySelector('.menu__tab-name');
      var subEl  = tab.querySelector('.menu__tab-sub');
      if (nameEl && name !== null) nameEl.textContent = name;
      if (subEl  && sub  !== null) subEl.textContent  = sub;
    });

    // Modal CTA text
    var ctaEl = document.getElementById('modal-cta');
    if (ctaEl) {
      var ctaVal = isID ? ctaEl.getAttribute('data-id') : ctaEl.getAttribute('data-en');
      if (ctaVal) {
        var svgEl = ctaEl.querySelector('svg');
        ctaEl.textContent = ctaVal;
        if (svgEl) ctaEl.insertBefore(svgEl, ctaEl.firstChild);
      }
    }

    // Refresh open modal
    if (isOpen && currentItem) openModal(currentItem);
  });

  /* ── Reveal ─────────────────────────────────────────────── */
  var ro = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.06 });
  document.querySelectorAll('.reveal').forEach(function(el) { ro.observe(el); });

});
</script>