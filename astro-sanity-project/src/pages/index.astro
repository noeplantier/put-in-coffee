<style is:global>
/* ── Design tokens ──────────────────────────────────────────── */
:root {
  --section-py: 5rem;
  --container-px: 1.5rem;
  --content-width: 1100px;
  --radius-card: 16px;
  --radius-sm: 10px;
  --gold:   #C9924A;
  --gold-lt:#E8C97A;
  --coral:  #E07A5F;
  --cream:  #F0E8DC;
  --muted:  rgba(240,232,220,0.45);
  --border: rgba(240,232,220,0.08);
  --glass:  rgba(240,232,220,0.03);
  --bg:     #0e0d0b;
  --bg2:    #0e0d0b;
}

/* ── Layout helpers ─────────────────────────────────────────── */
.pc-section   { padding: var(--section-py) 0; }
.pc-container { max-width: var(--content-width); margin: 0 auto; padding: 0 var(--container-px); }
.eyebrow      { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }

/* ── Reveals ────────────────────────────────────────────────── */
.reveal       { opacity:0; transform:translateY(18px);  transition:opacity .55s ease,transform .55s ease; }
.reveal.in    { opacity:1; transform:none; }
.reveal-scale { opacity:0; transform:scale(0.97);       transition:opacity .6s ease,transform .6s ease; }
.reveal-scale.in { opacity:1; transform:none; }

/* ════════════════════════════════════════════════════════════
   ABOUT
════════════════════════════════════════════════════════════ */
.about__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem; align-items: center;
}
@media (max-width:860px) { .about__grid { grid-template-columns:1fr; gap:2.5rem; } }

/* ── Photo carousel ────────────────────────────────────────── */
.about__carousel { position: relative; }

.about__slides {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  background: var(--bg2);
}

.about__slide {
  position: absolute; inset: 0;
  opacity: 0; transition: opacity 0.55s ease;
  pointer-events: none;
}
.about__slide--active { opacity: 1; pointer-events: auto; }

.about__slide-img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 6s ease;
}
.about__slide--active .about__slide-img { transform: scale(1.04); }

/* Caption */
.about__caption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 2.5rem 1.5rem 1.5rem;
  background: linear-gradient(to top, rgba(10,8,5,0.85) 0%, transparent 100%);
}
.about__caption-tag {
  display: inline-block;
  font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--gold);
  background: rgba(201,146,74,0.14);
  border: 1px solid rgba(201,146,74,0.25);
  border-radius: 50px; padding: 2px 8px; margin-bottom: 0.45rem;
}
.about__caption-desc {
  font-size: 0.78rem; font-weight: 300;
  color: rgba(240,232,220,0.75); line-height: 1.55; margin: 0;
}

/* Controls row */
.about__controls {
  margin-top: 0.85rem;
  display: flex; flex-direction: column; gap: 0.75rem;
}


.about__thumb {
  flex: 0 0 54px;
  width: 54px; height: 40px;
  border-radius: 7px; overflow: hidden;
  border: 2px solid transparent;
  background: none; padding: 0; cursor: pointer;
  transition: border-color 0.2s, opacity 0.2s;
  opacity: 0.45;
}
.about__thumb--on { border-color: var(--gold); opacity: 1; }
.about__thumb:hover { opacity: 0.8; }
.about__thumb-img { width:100%; height:100%; object-fit:cover; display:block; }

/* Counter + arrows */
.about__nav-row {
  display: flex; align-items: center;
  justify-content: space-between;
}
.about__counter {
  font-family: var(--font-display, serif);
  font-size: 0.82rem; font-style: italic; color: var(--muted);
  display: flex; align-items: center; gap: 0.2rem;
}
#about-current { color: var(--gold-lt); }
.about__counter-sep { color: var(--border); margin: 0 1px; }

.about__arrows { display: flex; gap: 0.4rem; }
.about__arrow {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--glass); border: 1px solid var(--border);
  color: var(--muted); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s, color .2s, border-color .2s;
}
.about__arrow:hover {
  background: rgba(201,146,74,0.1);
  border-color: rgba(201,146,74,0.3);
  color: var(--cream);
}

/* Year badge */
.about__year-badge {
  position: absolute; top: 16px; right: 16px;
  background: var(--gold); color:rgb(255, 255, 255);
  border-radius: var(--radius-sm); padding: 0.75rem 0.9rem;
  text-align: center; z-index: 2;
}
.about__year-num {
  display: block;
  font-family: var(--font-display, serif);
  font-size: 1.6rem; font-weight: 700; line-height: 1;
}
.about__year-sub {
  display: block; font-size: 0.6rem;
  letter-spacing: 0.12em; text-transform: uppercase; margin-top: 2px;
}

/* Text side */
.about__h2 {
  font-size: clamp(1.6rem, 3vw, 2.25rem);
  color: var(--cream); margin: 0.6rem 0 1.5rem;
  line-height: 1.2; text-transform: lowercase;
}
.about__prose { display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem; }
.about__prose p { font-size: 0.9rem; font-weight: 300; color: var(--muted); line-height: 1.75; }
.about__stats { display: grid; grid-template-columns: repeat(2,1fr); gap: 0.75rem; }
.about__stat { background: var(--glass); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem 1.1rem; }
.about__stat-value { display:block; font-family:var(--font-display,serif); font-size:1.45rem; color:var(--gold); font-style:italic; }
.about__stat-label { display:block; font-size:0.7rem; color:var(--muted); margin-top:3px; text-transform:lowercase; }

/* ════════════════════════════════════════════════════════════
   EXPERIENCE CAROUSEL
════════════════════════════════════════════════════════════ */
.xp { background: var(--bg2); }
.xp__head { text-align:center; margin-bottom:3rem; }
.xp__title { font-size:clamp(1.6rem,3vw,2.2rem); color:var(--cream); text-transform:lowercase; margin:.5rem 0 0; }

.xp__carousel { position:relative; }
.xp__track { display:grid; grid-template-columns:1fr; }

.xp__slide {
  grid-column:1; grid-row:1;
  opacity:0; pointer-events:none;
  transform:translateX(28px);
  transition:opacity .45s ease,transform .45s ease;
}
.xp__slide--active   { opacity:1; pointer-events:auto; transform:translateX(0); }
.xp__slide--exit-left{ opacity:0; transform:translateX(-28px); }

.xp__slide-inner {
  display:grid; grid-template-columns:1fr 200px; gap:3rem;
  background:var(--glass); border:1px solid var(--border);
  border-radius:20px; padding:3rem 3rem 3rem 3.5rem;
  min-height:320px; align-items:center;
  position:relative; overflow:hidden;
}
.xp__slide-inner::before {
  content:''; position:absolute; left:0; top:18%; bottom:18%;
  width:3px; background:var(--slide-accent,var(--gold));
  border-radius:0 2px 2px 0; opacity:0.7;
}
@media (max-width:760px) {
  .xp__slide-inner { grid-template-columns:1fr; padding:2rem 1.5rem; min-height:auto; gap:1.5rem; }
  .xp__num-col { display:none; }
}

.xp__icon-wrap { width:52px; height:52px; border-radius:14px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.06); display:flex; align-items:center; justify-content:center; margin-bottom:1.25rem; }
.xp__icon { color:var(--slide-accent,var(--gold-lt)); }
.xp__label { font-size:.68rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--slide-accent,var(--gold)); margin-bottom:.6rem; }
.xp__slide-title { font-size:clamp(1.1rem,2.2vw,1.5rem); font-weight:500; color:var(--cream); text-transform:lowercase; line-height:1.25; margin:0 0 1rem; }
.xp__body { font-size:.875rem; font-weight:300; color:var(--muted); line-height:1.8; max-width:560px; margin:0 0 1.5rem; }
.xp__stat { display:inline-flex; align-items:baseline; gap:.5rem; background:rgba(255,255,255,.03); border:1px solid var(--border); border-radius:50px; padding:.35rem .9rem; }
.xp__stat-value { font-family:var(--font-display,serif); font-size:1rem; font-style:italic; color:var(--slide-accent,var(--gold-lt)); }
.xp__stat-label { font-size:.68rem; color:var(--muted); text-transform:lowercase; }

.xp__num-col { display:flex; align-items:center; justify-content:center; position:relative; }
.xp__big-num { font-family:var(--font-display,serif); font-size:7rem; font-weight:700; font-style:italic; color:var(--slide-accent,var(--gold)); opacity:.08; line-height:1; user-select:none; }
.xp__ambient { position:absolute; inset:-20px; background:radial-gradient(circle,var(--slide-accent,rgba(201,146,74,.12)) 0%,transparent 70%); opacity:.25; pointer-events:none; }

.xp__nav { display:flex; align-items:center; justify-content:space-between; margin-top:1.75rem; gap:1rem; }
.xp__dots { display:flex; gap:.25rem; flex-wrap:wrap; flex:1; }
.xp__dot { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; background:none; border:none; cursor:pointer; padding:.5rem 0.65rem .5rem 0; color:var(--muted); font-family:var(--font-body,sans-serif); font-size:.72rem; text-transform:lowercase; transition:color .2s; }
.xp__dot:hover, .xp__dot--on { color:var(--cream); }
.xp__dot-line { display:block; width:24px; height:2px; background:var(--border); border-radius:2px; transition:width .3s,background .3s; }
.xp__dot--on .xp__dot-line { width:40px; background:var(--gold); }
.xp__dot-label { font-size:.68rem; }
@media (max-width:600px) { .xp__dot-label { display:none; } .xp__dot-line { width:16px; } .xp__dot--on .xp__dot-line { width:28px; } }

.xp__arrows { display:flex; gap:.5rem; flex-shrink:0; }
.xp__arrow { width:38px; height:38px; border-radius:50%; background:var(--glass); border:1px solid var(--border); color:var(--muted); cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background .2s,color .2s,border-color .2s; }
.xp__arrow:hover { background:rgba(201,146,74,.08); border-color:rgba(201,146,74,.3); color:var(--cream); }

/* ════════════════════════════════════════════════════════════
   LOCATION
════════════════════════════════════════════════════════════ */
.loc__grid { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:start; }
@media (max-width:860px) { .loc__grid { grid-template-columns:1fr; gap:2.5rem; } }
.loc__h2 { font-size:clamp(1.6rem,3vw,2.2rem); color:var(--cream); text-transform:lowercase; margin:.6rem 0 1.75rem; line-height:1.2; }

.loc__contacts { display:flex; flex-direction:column; }
.loc__contact-item { display:flex; gap:.85rem; align-items:flex-start; padding:1.1rem 0; border-bottom:1px solid var(--border); }
.loc__contact-item:last-child { border-bottom:none; }
.loc__contact-icon { width:38px; height:38px; flex-shrink:0; border-radius:var(--radius-sm); background:rgba(201,146,74,.06); border:1px solid rgba(201,146,74,.12); display:flex; align-items:center; justify-content:center; color:var(--gold); }
.loc__contact-label { font-size:.65rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin:0 0 3px; }
.loc__contact-val { font-size:.875rem; color:var(--cream); margin:0; }

.loc__hours { margin-top:1.75rem; }
.loc__hours-head { font-size:.65rem; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); margin-bottom:.75rem; }
.loc__hours-list { display:flex; flex-direction:column; gap:.55rem; }
.loc__hours-row { display:flex; justify-content:space-between; font-size:.875rem; color:var(--muted); }
.loc__hours-row--hi { color:var(--gold); font-weight:500; }
.loc__hours-row--hi span { color:var(--gold); }

.loc__map-card { display:flex; flex-direction:column; align-items:center; text-align:center; gap:.75rem; background:var(--glass); border:1px solid var(--border); border-radius:20px; padding:3rem 2rem; position:sticky; top:100px; }
.loc__map-name { font-family:var(--font-display,serif); font-size:1.35rem; color:var(--cream); font-style:italic; margin:0; }
.loc__map-sub { font-size:.82rem; color:var(--muted); margin:0; }
.loc__map-btn { display:inline-flex; align-items:center; gap:.5rem; margin-top:.5rem; padding:.7rem 1.4rem; border-radius:50px; background:linear-gradient(135deg,var(--coral),var(--gold)); color:#0a0800; font-size:.8rem; font-weight:600; text-decoration:none; text-transform:lowercase; transition:opacity .2s,box-shadow .2s; }
.loc__map-btn:hover { opacity:.9; box-shadow:0 6px 20px rgba(201, 146, 74, 0.14); }

/* ════════════════════════════════════════════════════════════
   FOOTER
════════════════════════════════════════════════════════════ */
.pc-footer { border-top:1px solid var(--border); }
.footer__grid { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:3rem; padding:3.5rem 0; border-bottom:1px solid var(--border); }
@media (max-width:860px) { .footer__grid { grid-template-columns:1fr 1fr; gap:2rem; } .footer__brand { grid-column:1/-1; } }
@media (max-width:540px) { .footer__grid { grid-template-columns:1fr; } }

.footer__logo { display:flex; align-items:center; gap:.45rem; font-family:var(--font-display,serif); font-size:1.15rem; font-weight:700; color:var(--cream); text-transform:lowercase; margin-bottom:.75rem; font-style:italic; }
.footer__logo-accent { color:var(--gold); }
.footer__tagline { font-size:.8rem; color:var(--muted); line-height:1.7; max-width:280px; margin:0 0 1rem; }
.footer__socials { display:flex; gap:.5rem; }
.footer__social-btn { width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,.04); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--muted); text-decoration:none; transition:background .2s,color .2s,border-color .2s; }
.footer__social-btn:hover { background:rgba(201,146,74,.1); border-color:rgba(201,146,74,.3); color:var(--gold); }
.footer__col-head { font-size:.65rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); margin:0 0 1rem; }
.footer__nav-col ul { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:.55rem; }
.footer__link { font-size:.82rem; color:var(--muted); text-decoration:none; transition:color .2s; text-transform:lowercase; }
.footer__link:hover { color:var(--cream); }
.footer__bottom { display:flex; flex-wrap:wrap; gap:1rem; justify-content:space-between; align-items:center; padding:1.25rem 0; font-size:.75rem; color:var(--muted); }
.footer__bottom-links { display:flex; gap:1.25rem; }

@media (prefers-reduced-motion:reduce) {
  .reveal,.reveal-scale,.xp__slide,.about__slide,.about__slide-img { transition:none !important; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Reveal on scroll ───────────────────────────────────── */
  var ro = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal, .reveal-scale').forEach(function (el) { ro.observe(el); });

  /* ── ABOUT photo carousel ───────────────────────────────── */
  var aSlides  = document.querySelectorAll('.about__slide');
  var aThumbs  = document.querySelectorAll('.about__thumb');
  var aPrev    = document.getElementById('about-prev');
  var aNext    = document.getElementById('about-next');
  var aCurrent = document.getElementById('about-current');
  var aIdx     = 0;
  var aTotal   = aSlides.length;
  var aTimer   = null;

  function aGoTo(idx) {
    aSlides[aIdx].classList.remove('about__slide--active');
    aSlides[aIdx].setAttribute('aria-hidden', 'true');
    aThumbs[aIdx].classList.remove('about__thumb--on');
    aThumbs[aIdx].setAttribute('aria-selected', 'false');

    aIdx = (idx + aTotal) % aTotal;

    aSlides[aIdx].classList.add('about__slide--active');
    aSlides[aIdx].setAttribute('aria-hidden', 'false');
    aThumbs[aIdx].classList.add('about__thumb--on');
    aThumbs[aIdx].setAttribute('aria-selected', 'true');
    if (aCurrent) aCurrent.textContent = String(aIdx + 1);


  }

  function aSchedule() {
    aTimer = setTimeout(function () { aGoTo(aIdx + 1); aSchedule(); }, 5000);
  }
  aSchedule();

  aThumbs.forEach(function (th) {
    th.addEventListener('click', function () {
      clearTimeout(aTimer);
      aGoTo(parseInt(th.getAttribute('data-goto') || '0'));
      aSchedule();
    });
  });
  if (aPrev) aPrev.addEventListener('click', function () { clearTimeout(aTimer); aGoTo(aIdx - 1); aSchedule(); });
  if (aNext) aNext.addEventListener('click', function () { clearTimeout(aTimer); aGoTo(aIdx + 1); aSchedule(); });

  // Touch swipe on about carousel
  var aTrack = document.getElementById('about-track');
  var aTouchX = 0;
  if (aTrack) {
    aTrack.addEventListener('touchstart', function (e) { aTouchX = e.touches[0].clientX; }, { passive: true });
    aTrack.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - aTouchX;
      if (Math.abs(dx) > 50) { clearTimeout(aTimer); aGoTo(dx < 0 ? aIdx + 1 : aIdx - 1); aSchedule(); }
    }, { passive: true });
  }

  /* ── EXPERIENCE carousel ────────────────────────────────── */
  var xSlides = document.querySelectorAll('.xp__slide');
  var xDots   = document.querySelectorAll('.xp__dot');
  var xPrev   = document.getElementById('xp-prev');
  var xNext   = document.getElementById('xp-next');
  var xIdx    = 0;
  var xTotal  = xSlides.length;
  var xTimer  = null;

  function xGoTo(idx) {
    if (idx === xIdx && xTotal > 1) {
      // same index: no-op unless total=1
    }
    xSlides[xIdx].classList.remove('xp__slide--active');
    xSlides[xIdx].classList.add('xp__slide--exit-left');
    xSlides[xIdx].setAttribute('aria-hidden', 'true');
    xDots[xIdx].classList.remove('xp__dot--on');
    xDots[xIdx].setAttribute('aria-selected', 'false');

    var exiting = xSlides[xIdx];
    setTimeout(function () { exiting.classList.remove('xp__slide--exit-left'); }, 420);

    xIdx = (idx + xTotal) % xTotal;

    xSlides[xIdx].classList.add('xp__slide--active');
    xSlides[xIdx].setAttribute('aria-hidden', 'false');
    xDots[xIdx].classList.add('xp__dot--on');
    xDots[xIdx].setAttribute('aria-selected', 'true');
  }

  function xSchedule() {
    xTimer = setTimeout(function () { xGoTo(xIdx + 1); xSchedule(); }, 6000);
  }
  xSchedule();

  xDots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      clearTimeout(xTimer);
      xGoTo(parseInt(dot.getAttribute('data-goto') || '0'));
      xSchedule();
    });
  });
  if (xPrev) xPrev.addEventListener('click', function () { clearTimeout(xTimer); xGoTo(xIdx - 1); xSchedule(); });
  if (xNext) xNext.addEventListener('click', function () { clearTimeout(xTimer); xGoTo(xIdx + 1); xSchedule(); });

  var xTrack  = document.getElementById('xp-track');
  var xTouchX = 0;
  if (xTrack) {
    xTrack.addEventListener('touchstart', function (e) { xTouchX = e.touches[0].clientX; }, { passive: true });
    xTrack.addEventListener('touchend', function (e) {
      var dx = e.changedTouches[0].clientX - xTouchX;
      if (Math.abs(dx) > 50) { clearTimeout(xTimer); xGoTo(dx < 0 ? xIdx + 1 : xIdx - 1); xSchedule(); }
    }, { passive: true });
  }

  document.addEventListener('keydown', function (e) {
    var xc = document.getElementById('xp-carousel');
    if (!xc) return;
    var r = xc.getBoundingClientRect();
    if (r.top < window.innerHeight && r.bottom > 0) {
      if (e.key === 'ArrowLeft')  { clearTimeout(xTimer); xGoTo(xIdx - 1); xSchedule(); }
      if (e.key === 'ArrowRight') { clearTimeout(xTimer); xGoTo(xIdx + 1); xSchedule(); }
    }
  });

  /* ── Language switching ─────────────────────────────────── */
  document.addEventListener('pc:lang', function (e) {
    var isID = e.detail && e.detail.isID;

    // Text nodes
    document.querySelectorAll('[data-en][data-id]').forEach(function (el) {
      if (el.children.length > 0) return; // skip elements with child elements
      var val = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (val !== null) el.textContent = val;
    });

    // h2 with <br>
    document.querySelectorAll('h2[data-en][data-id]').forEach(function (el) {
      var raw = isID ? el.getAttribute('data-id') : el.getAttribute('data-en');
      if (raw !== null) el.innerHTML = raw;
    });

    // img alt attributes
    document.querySelectorAll('img[data-en-alt][data-id-alt]').forEach(function (img) {
      img.setAttribute('alt', isID ? img.getAttribute('data-id-alt') : img.getAttribute('data-en-alt'));
    });

    // loc__map-btn inner text (has child svg)
    var mapBtn = document.querySelector('.loc__map-btn');
    if (mapBtn) {
      var mapVal = isID ? mapBtn.getAttribute('data-id') : mapBtn.getAttribute('data-en');
      if (mapVal) {
        var svgEl = mapBtn.querySelector('svg');
        mapBtn.textContent = mapVal;
        if (svgEl) mapBtn.insertBefore(svgEl, mapBtn.firstChild);
      }
    }
  });

  /* ── Maps tracking ──────────────────────────────────────── */
  var mapsBtn = document.querySelector('[data-event="Maps Click"]');
  if (mapsBtn) mapsBtn.addEventListener('click', function () {
    if (window.plausible) window.plausible('Maps Click');
  });

  /* ── Newsletter ─────────────────────────────────────────── */
  var nlForm = document.getElementById('newsletter-form');
  if (nlForm) {
    nlForm.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      var ei = nlForm.querySelector('input[type="email"]');
      if (!ei || !ei.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(ei.value)) {
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type:'error', title:'Invalid email', message:'Please enter a valid email.' } }));
        return;
      }
      try {
        await fetch('/', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams(new FormData(nlForm)).toString() });
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type:'success', title:"You're in! ☕", message:'Welcome to the put.in family!' } }));
        if (window.plausible) window.plausible('Newsletter Signup');
        ei.value = '';
      } catch {
        window.dispatchEvent(new CustomEvent('pc:toast', { detail: { type:'error', title:'Error', message:'Please try again later.' } }));
      }
    });
  }

});
</script>