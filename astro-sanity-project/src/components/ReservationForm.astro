---
// src/components/ReservationForm.astro
// Reservation & contact · refined · lowercase · EN / ID
// Netlify Forms — no backend needed
---

<!-- ══ CONTACT ════════════════════════════════════════════════ -->
<section class="res pc-section" id="contact" aria-label="reserve a table">
  <div class="wrap res__inner">

    <!-- ── left: info ─────────────────────────────────────── -->
    <div class="res__info">

      <p class="eyebrow reveal" data-en="get in touch" data-id="hubungi kami">get in touch</p>

      <h2 class="res__title reveal">
        <span data-en="reserve your" data-id="pesan meja anda">reserve your</span><br>
        <em data-en="slice of paradise" data-id="surga tepi pantai">slice of paradise</em>
      </h2>

      <p class="res__sub reveal" 
         data-en="sunrise coffee, romantic sunset dinners, or a private beach event — we'll make every moment count at pantai biaung."
         data-id="kopi pagi hari, makan malam romantis, atau acara privat di tepi pantai — kami akan membuat setiap momen berharga di pantai biaung.">
        sunrise coffee, romantic sunset dinners, or a private beach event — we'll make every moment count at pantai biaung.
      </p>

      <!-- info cards -->
      <div class="res__cards reveal">
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">🕐</span>
          <div>
            <strong data-en="hours" data-id="jam buka">hours</strong>
            <span data-en="7am – 11pm · daily" data-id="07.00 – 23.00 · setiap hari">7am – 11pm · daily</span>
          </div>
        </div>
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">📍</span>
          <div>
            <strong data-en="location" data-id="lokasi">location</strong>
            <span data-en="pantai biaung, sanur, bali" data-id="pantai biaung, sanur, bali">pantai biaung, sanur, bali</span>
          </div>
        </div>
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">⚡</span>
          <div>
            <strong data-en="response" data-id="respons">response</strong>
            <span data-en="within 2 hours · no card needed" data-id="dalam 2 jam · tanpa kartu kredit">within 2 hours · no card needed</span>
          </div>
        </div>
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">🌊</span>
          <div>
            <strong data-en="vibe" data-id="suasana">vibe</strong>
            <span data-en="beachfront · free wifi · dogs welcome" data-id="tepi pantai · wifi gratis · boleh bawa anjing">beachfront · free wifi · dogs welcome</span>
          </div>
        </div>
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">🅿️</span>
          <div>
            <strong data-en="parking" data-id="parkir">parking</strong>
            <span data-en="free on-site parking · motorbike & car" data-id="parkir gratis · motor & mobil">free on-site parking · motorbike & car</span>
          </div>
        </div>
        <div class="res__card pc-card">
          <span class="res__card-icon" aria-hidden="true">🎵</span>
          <div>
            <strong data-en="live music" data-id="musik live">live music</strong>
            <span data-en="fri & sat evenings · local artists" data-id="jumat & sabtu malam · seniman lokal">fri & sat evenings · local artists</span>
          </div>
        </div>
      </div>

      <!-- social -->
      <div class="res__socials reveal">
        <a href="https://instagram.com/putincoffee" class="res__social-btn" target="_blank" rel="noopener" aria-label="instagram">📸</a>
        <a href="https://facebook.com/putincoffee" class="res__social-btn" target="_blank" rel="noopener" aria-label="facebook">📘</a>
        <a href="https://tiktok.com/@putincoffee" class="res__social-btn" target="_blank" rel="noopener" aria-label="tiktok">🎵</a>
        <a
          id="whatsapp-link"
          href="https://wa.me/628123456789"
          class="res__social-btn res__social-wa"
          target="_blank" rel="noopener"
          aria-label="whatsapp"
        >
          <span aria-hidden="true">💬</span>
          <span class="res__wa-label" data-en="chat on whatsapp" data-id="chat whatsapp">chat on whatsapp</span>
        </a>
        <button id="share-btn" class="res__social-btn" aria-label="share this page">🔗</button>
      </div>

    </div>

    <!-- ── right: form ─────────────────────────────────────── -->
    <div class="res__form-wrap reveal-scale" id="res-form-container">

      <form
        id="res-form"
        class="res__form"
        name="reservation"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
      >
        <input type="hidden" name="form-name" value="reservation">
        <p class="res__honeypot" aria-hidden="true">
          <label>skip: <input name="bot-field" tabindex="-1" autocomplete="off"></label>
        </p>

        <h3 class="res__form-title" data-en="make a reservation" data-id="buat reservasi">make a reservation</h3>

        <!-- row 1 -->
        <div class="res__row">
          <div class="res__field">
            <label for="r-name" class="res__label">
              <span data-en="full name" data-id="nama lengkap">full name</span>
              <span class="res__req" aria-label="required">*</span>
            </label>
            <input type="text" id="r-name" name="name" class="pc-input" placeholder="your name" required autocomplete="name">
          </div>
          <div class="res__field">
            <label for="r-email" class="res__label">
              <span data-en="email" data-id="email">email</span>
              <span class="res__req">*</span>
            </label>
            <input type="email" id="r-email" name="email" class="pc-input" placeholder="you@email.com" required autocomplete="email">
          </div>
        </div>

        <!-- row 2 -->
        <div class="res__row">
          <div class="res__field">
            <label for="r-phone" class="res__label">
              <span data-en="whatsapp / phone" data-id="whatsapp / telepon">whatsapp / phone</span>
            </label>
            <input type="tel" id="r-phone" name="phone" class="pc-input" placeholder="+62 …" autocomplete="tel">
          </div>
          <div class="res__field">
            <label for="r-guests" class="res__label">
              <span data-en="guests" data-id="jumlah tamu">guests</span>
            </label>
            <select id="r-guests" name="guests" class="pc-input">
              <option value="" data-en="select…" data-id="pilih…">select…</option>
              <option value="1"   data-en="1 guest"            data-id="1 tamu">1 guest</option>
              <option value="2"   data-en="2 guests"           data-id="2 tamu">2 guests</option>
              <option value="3-5" data-en="3–5 guests"         data-id="3–5 tamu">3–5 guests</option>
              <option value="6-10"data-en="6–10 guests"        data-id="6–10 tamu">6–10 guests</option>
              <option value="10+" data-en="10+ (private event)"data-id="10+ (acara privat)">10+ (private event)</option>
            </select>
          </div>
        </div>

        <!-- row 3 -->
        <div class="res__row">
          <div class="res__field">
            <label for="r-date" class="res__label">
              <span data-en="preferred date" data-id="tanggal pilihan">preferred date</span>
            </label>
            <input type="date" id="r-date" name="date" class="pc-input">
          </div>
          <div class="res__field">
            <label for="r-time" class="res__label">
              <span data-en="preferred time" data-id="waktu pilihan">preferred time</span>
            </label>
            <select id="r-time" name="time" class="pc-input">
              <option value="">select time…</option>
              <option value="07:00" data-en="7:00 am — sunrise 🌅" data-id="07.00 — matahari terbit 🌅">7:00 am — sunrise 🌅</option>
              <option value="09:00" data-en="9:00 am — morning ☀️" data-id="09.00 — pagi ☀️">9:00 am — morning ☀️</option>
              <option value="12:00" data-en="12:00 pm — lunch 🍽️"  data-id="12.00 — makan siang 🍽️">12:00 pm — lunch 🍽️</option>
              <option value="15:00" data-en="3:00 pm — afternoon 🌤️" data-id="15.00 — sore 🌤️">3:00 pm — afternoon 🌤️</option>
              <option value="17:30" data-en="5:30 pm — sunset 🌅"  data-id="17.30 — senja 🌅">5:30 pm — sunset 🌅</option>
              <option value="19:00" data-en="7:00 pm — dinner 🌙"  data-id="19.00 — makan malam 🌙">7:00 pm — dinner 🌙</option>
            </select>
          </div>
        </div>

        <!-- notes -->
        <div class="res__field">
          <label for="r-msg" class="res__label">
            <span data-en="special requests" data-id="permintaan khusus">special requests</span>
          </label>
          <textarea id="r-msg" name="message" class="pc-input" rows="3"
            placeholder="allergies, special occasions, seating preferences…"
          ></textarea>
        </div>

        <!-- submit -->
        <button type="submit" id="res-submit" class="btn btn-primary res__submit">
          <span class="res__submit-text" data-en="☕ send reservation" data-id="☕ kirim reservasi">☕ send reservation</span>
        </button>

        <p class="res__note"
           data-en="we reply within 2 hours · free · no credit card needed"
           data-id="kami membalas dalam 2 jam · gratis · tanpa kartu kredit">
          we reply within 2 hours · free · no credit card needed
        </p>
      </form>

      <!-- success -->
      <div id="res-success" class="res__success" hidden>
        <div class="res__success-icon">🎉</div>
        <h3 data-en="reservation received!" data-id="reservasi diterima!">reservation received!</h3>
        <p data-en="we'll confirm your table within 2 hours. see you at pantai biaung 🌊"
           data-id="kami akan mengkonfirmasi meja anda dalam 2 jam. sampai jumpa di pantai biaung 🌊">
          we'll confirm your table within 2 hours. see you at pantai biaung 🌊
        </p>
        <a href="#menu" class="btn btn-outline" data-en="← explore menu" data-id="← lihat menu">← explore menu</a>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Layout ──────────────────────────────────────────────── */
  .res__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .res__inner { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* ── Left info ───────────────────────────────────────────── */
  .res__title {
    text-transform: lowercase;
    margin: 0.4rem 0 1rem;
  }
  .res__title em {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(135deg, var(--gold-lt), var(--gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .res__sub {
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 2rem;
    text-transform: lowercase;
  }

  /* info cards grid */
  .res__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }
  .res__card {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.8rem 0.9rem;
    cursor: default;
  }
  .res__card-icon { font-size: 1.1rem; flex-shrink: 0; line-height: 1.4; }
  .res__card div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .res__card strong {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 0.06em;
    text-transform: lowercase;
  }
  .res__card span {
    font-size: 0.68rem;
    font-weight: 300;
    color: var(--muted);
    text-transform: lowercase;
    line-height: 1.4;
  }

  /* socials */
  .res__socials {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .res__social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--glass);
    border: 1px solid var(--border);
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s, background 0.2s;
    color: var(--cream);
  }
  .res__social-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(201,146,74,0.3);
    background: rgba(201,146,74,0.06);
    color: var(--cream);
  }
  .res__social-wa {
    width: auto;
    border-radius: 50px;
    padding: 0 1rem;
    background: rgba(37,211,102,0.07);
    border-color: rgba(37,211,102,0.18);
    color: #4ade80;
    gap: 6px;
  }
  .res__social-wa:hover { border-color: rgba(37,211,102,0.35); color: #4ade80; }
  .res__wa-label { font-size: 0.74rem; font-weight: 400; white-space: nowrap; }

  /* ── Form ────────────────────────────────────────────────── */
  .res__form {
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    backdrop-filter: blur(12px);
  }
  .res__honeypot { display: none; }
  .res__form-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--cream);
    margin: 0 0 1.5rem;
    text-transform: lowercase;
  }
  .res__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }
  @media (max-width: 500px) { .res__row { grid-template-columns: 1fr; } }
  .res__field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 0.85rem;
  }
  .res__label {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: lowercase;
    display: flex;
    gap: 2px;
    align-items: center;
  }
  .res__req { color: var(--coral); }
  select.pc-input option { background: #1a1110; color: var(--cream); }
  input[type="date"].pc-input::-webkit-calendar-picker-indicator { filter: invert(0.6); cursor: pointer; }
  textarea.pc-input { resize: none; line-height: 1.6; }

  .res__submit {
    width: 100%;
    margin-top: 0.25rem;
    font-size: 0.8rem;
  }
  .res__note {
    text-align: center;
    font-size: 0.66rem;
    font-weight: 300;
    color: var(--muted);
    margin: 0.65rem 0 0;
    line-height: 1.5;
    text-transform: lowercase;
  }

  /* ── Success ─────────────────────────────────────────────── */
  .res__success {
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 3rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-height: 380px;
    justify-content: center;
  }
  [hidden] { display: none !important; }
  .res__success-icon { font-size: 3rem; animation: pop-in 0.5s cubic-bezier(0.34,1.56,0.64,1); }
  @keyframes pop-in { from { transform: scale(0); } to { transform: scale(1); } }
  .res__success h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    text-transform: lowercase;
    margin: 0;
  }
  .res__success p { font-size: 0.85rem; max-width: 280px; text-transform: lowercase; }

  /* reveal */
  .reveal-scale {
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal-scale.in { opacity: 1; transform: scale(1); }

  @media (max-width: 500px) {
    .res__form { padding: 1.25rem; }
  }
</style>

<script>
  // date min
  const dateInput = document.getElementById('r-date') as HTMLInputElement;
  if (dateInput) {
    const n = new Date();
    const p = (v: number) => String(v).padStart(2,'0');
    dateInput.min = `${n.getFullYear()}-${p(n.getMonth()+1)}-${p(n.getDate())}`;
  }

  // form
  const form       = document.getElementById('res-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('res-submit') as HTMLButtonElement;
  const success    = document.getElementById('res-success')!;
  const submitText = submitBtn?.querySelector('.res__submit-text') as HTMLElement;

  const toast = (type: string, title: string, msg: string) =>
    window.dispatchEvent(new CustomEvent('pc:toast', { detail:{ type, title, message: msg } }));

  form?.addEventListener('submit', async e => {
    e.preventDefault();
    const name  = (document.getElementById('r-name')  as HTMLInputElement).value.trim();
    const email = (document.getElementById('r-email') as HTMLInputElement).value.trim();
    if (!name)    { toast('error','name required','please enter your full name.'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { toast('error','invalid email','please enter a valid email.'); return; }

    submitBtn.disabled = true;
    if (submitText) submitText.textContent = 'sending… ✈️';

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as unknown as Record<string,string>).toString(),
      });
      if (res.ok) {
        form.hidden = true;
        success.hidden = false;
        // @ts-ignore
        if (window.plausible) window.plausible('Reservation Submit');
        toast('success','reservation received! 🎉',"we'll confirm your table within 2 hours.");
      } else throw new Error();
    } catch {
      toast('error','something went wrong','please try whatsapp or call us directly.');
      submitBtn.disabled = false;
      if (submitText) submitText.textContent = '☕ send reservation';
    }
  });

  // share
  document.getElementById('share-btn')?.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({ title:'put.in coffee — pantai biaung', text:'the best coffee spot on the beach ☕🌊', url: location.href });
      } else {
        await navigator.clipboard.writeText(location.href);
        toast('success','link copied! 🔗','share put.in coffee with your friends');
      }
    } catch {}
  });

  document.getElementById('whatsapp-link')?.addEventListener('click', () => {
    // @ts-ignore
    if (window.plausible) window.plausible('WhatsApp Click');
  });

  // language
  document.addEventListener('pc:lang', ((e: CustomEvent) => {
    const isID = e.detail.isID as boolean;
    document.querySelectorAll<HTMLElement>('[data-en][data-id]').forEach(el => {
      if (el.tagName === 'SELECT' || el.tagName === 'OPTION') return;
      const val = isID ? el.dataset.id : el.dataset.en;
      if (val !== undefined) el.textContent = val;
    });
    document.querySelectorAll<HTMLOptionElement>('option[data-en]').forEach(o => {
      const val = isID ? o.dataset.id : o.dataset.en;
      if (val) o.textContent = val;
    });
  }) as EventListener);

  // reveal
  const ro = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); } });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal, .reveal-scale').forEach(el => ro.observe(el));
</script>