---
// src/pages/sitemap.astro  ·  put.in coffee  ·  Visual Sitemap
import LegalLayout from '../layouts/LegalLayout.astro';

const sections = [
  {
    en: 'main page', id_: 'halaman utama',
    icon: `<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><polyline points="9 22 9 12 15 12 15 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    links: [
      { en:'Hero — put.in coffee',  id_:'Hero — put.in coffee',  href:'/#hero',     desc:{en:'Welcome, tagline & CTAs',              id_:'Sambutan, tagline & CTA'} },
      { en:'Our Story',             id_:'Kisah Kami',            href:'/#about',    desc:{en:'Photo carousel & brand story',          id_:'Karousel foto & kisah merek'} },
      { en:'Reviews',               id_:'Ulasan',                href:'/#reviews',  desc:{en:'Guest reviews · 4.9★ Google',           id_:'Ulasan tamu · 4.9★ Google'} },
      { en:'The Menu',              id_:'Menu',                  href:'/#menu',     desc:{en:'Coffee, food, snacks & beer',           id_:'Kopi, makanan, camilan & bir'} },
      { en:'Location & Hours',      id_:'Lokasi & Jam Buka',     href:'/#location', desc:{en:'Interactive map · WITA live clock',     id_:'Peta interaktif · jam WITA'} },
      { en:'Reserve a Table',       id_:'Reservasi Meja',        href:'/#contact',  desc:{en:'Reservation form · Instagram DM',       id_:'Formulir reservasi · Instagram DM'} },
    ],
  },
  {
    en: 'legal', id_: 'hukum',
    icon: `<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.5" fill="none"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5" fill="none"/><line x1="9" y1="13" x2="15" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="9" y1="17" x2="12" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    links: [
      { en:'Privacy Policy', id_:'Kebijakan Privasi', href:'/privacy', desc:{en:'Data collection, retention & your rights', id_:'Pengumpulan data, retensi & hak Anda'} },
      { en:'Terms of Use',   id_:'Syarat Penggunaan', href:'/terms',   desc:{en:'Acceptable use, disclaimers & governing law', id_:'Penggunaan diterima, penafian & hukum berlaku'} },
      { en:'Sitemap',        id_:'Peta Situs',        href:'/sitemap', desc:{en:'You are here',       id_:'Anda sedang di sini'} },
    ],
  },
  {
    en: 'technical', id_: 'teknis',
    icon: `<polyline points="16 18 22 12 16 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/><polyline points="8 6 2 12 8 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`,
    links: [
      { en:'XML Sitemap', id_:'Sitemap XML',  href:'/sitemap-index.xml', desc:{en:'Machine-readable sitemap for search engines', id_:'Sitemap untuk mesin pencari'} },
      { en:'robots.txt',  id_:'robots.txt',   href:'/robots.txt',        desc:{en:'Crawl rules for bots',                        id_:'Aturan crawl untuk bot'} },
    ],
  },
  {
    en: 'social & shortcuts', id_: 'sosial & pintasan',
    icon: `<rect x="2" y="2" width="20" height="20" rx="5.5" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/>`,
    links: [
      { en:'Instagram',        id_:'Instagram',        href:'https://www.instagram.com/put.in.coffee/', desc:{en:'@put.in.coffee',     id_:'@put.in.coffee'} },
      { en:'WhatsApp',         id_:'WhatsApp',         href:'https://wa.me/6281916334989',             desc:{en:'+62 819-1633-4989',  id_:'+62 819-1633-4989'} },
      { en:'TikTok',           id_:'TikTok',           href:'https://www.tiktok.com/@put.in_coffee',   desc:{en:'@put.in_coffee',     id_:'@put.in_coffee'} },
      { en:'Google Maps',      id_:'Google Maps',      href:'https://www.google.com/maps/search/put.in+coffee+Pantai+Biaung+Denpasar', desc:{en:'Directions to Pantai Biaung', id_:'Petunjuk ke Pantai Biaung'} },
      { en:'/ig shortlink',    id_:'Pintasan /ig',     href:'/ig',    desc:{en:'Redirect → Instagram',     id_:'Pengalihan → Instagram'} },
      { en:'/wa shortlink',    id_:'Pintasan /wa',     href:'/wa',    desc:{en:'Redirect → WhatsApp',      id_:'Pengalihan → WhatsApp'} },
      { en:'/maps shortlink',  id_:'Pintasan /maps',   href:'/maps',  desc:{en:'Redirect → Google Maps',   id_:'Pengalihan → Google Maps'} },
    ],
  },
];
---

<LegalLayout
  title="Sitemap"
  titleId="Peta Situs"
  description="Complete sitemap of the put.in coffee website — every page, section, and shortlink."
  lastUpdated="June 2026"
  section="sitemap"
>

<div class="ls">

  <!-- Intro -->
  <div class="ls__intro">
    <p data-en="Every corner of the put.in coffee website, mapped like the coastline — clear, navigable, and worth exploring."
       data-id="Setiap sudut situs put.in coffee, dipetakan seperti garis pantai — jelas, dapat dinavigasi, dan layak dijelajahi.">
      Every corner of the put.in coffee website, mapped like the coastline — clear, navigable, and worth exploring.
    </p>
  </div>

  {sections.map((sec, si) => (
    <div class="ls__block">
      <div class="ls__block-head">
        <div class="ls__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={sec.icon}/>
        </div>
        <div>
          <span class="ls__num">{String(si + 1).padStart(2, '0')}</span>
          <h2 class="ls__block-title" data-en={sec.en} data-id={sec.id_}>{sec.en}</h2>
        </div>
      </div>
      <div class="ls__block-body">
        <div class="sm__list">
          {sec.links.map(link => (
            <a href={link.href}
               class="sm__item"
               target={link.href.startsWith('http') ? '_blank' : undefined}
               rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <div class="sm__item-left">
                <span class="sm__item-name" data-en={link.en} data-id={link.id_}>{link.en}</span>
                <span class="sm__item-desc" data-en={link.desc.en} data-id={link.desc.id_}>{link.desc.en}</span>
              </div>
              <span class="sm__item-arrow" aria-hidden="true">
                {link.href.startsWith('http') ? '↗' : '→'}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}

</div>

</LegalLayout>